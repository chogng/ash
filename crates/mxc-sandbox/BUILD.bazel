load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//:defs.bzl", "ash_rust_crate")

ash_rust_crate(
    name = "mxc-sandbox",
    crate_name = "mxc_sandbox",
)

rust_test(
    name = "macos-tests",
    crate_name = "macos",
    crate_root = "tests/macos.rs",
    srcs = ["tests/macos.rs"] + glob(["tests/macos/*.rs"]),
    edition = "2024",
    tags = ["no-sandbox"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = all_crate_deps(normal = True, normal_dev = True) + [":mxc-sandbox"],
)

rust_test(
    name = "pty-tests",
    crate_name = "pty",
    crate_root = "tests/pty.rs",
    srcs = ["tests/pty.rs", "tests/pty/cases.rs", "tests/pty/windows.rs"],
    edition = "2024",
    use_libtest_harness = False,
    # These scenarios exercise the OS sandbox and its terminal on the host.
    tags = ["no-sandbox"],
    deps = all_crate_deps(normal = True, normal_dev = True) + [":mxc-sandbox"],
)
