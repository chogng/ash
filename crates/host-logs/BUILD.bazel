load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")

ash_rust_crate(
    name = "host-logs",
    crate_name = "ash_host_logs",
    crate_features = ["export", "json-schema"],
    extra_deps = ["@crates//:schemars", "@crates//:ts-rs"],
)

ash_rust_binary(
    name = "ash-host-logs",
    crate_name = "ash_host_logs",
    crate_root = "src/main.rs",
    deps = [":host-logs"],
)
