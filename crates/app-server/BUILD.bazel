load("//:defs.bzl", "ash_rust_crate")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    data = ["Cargo.toml", "//extensions/code:client_sources"],
    # The digest reads a sibling package; the isolated manifest runfiles flatten this layout.
    build_script_env = {"CARGO_MANIFEST_DIR": "crates/app-server"},
    deps = ["//crates/utils/editor-client-build"],
    edition = "2024",
)

