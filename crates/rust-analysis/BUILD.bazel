load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")

# Standalone developer analysis process; product hosts do not depend on it.
ash_rust_crate(
    name = "rust-analysis",
    crate_name = "ash_rust_analysis",
)

ash_rust_binary(
    name = "ash-rust-analysis",
    crate_name = "ash_rust_analysis_bin",
    crate_root = "src/main.rs",
    deps = [":rust-analysis"],
)
