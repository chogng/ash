+        });
+
+        let captured = test_sink::take_verbose();
+        test_sink::clear();
+        assert_eq!(captured.len(), 1);
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&captured[0].content).unwrap(),
+            serde_json::json!([])
+        );
