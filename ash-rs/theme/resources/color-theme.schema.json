{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ash.dev/schemas/app/color-theme.schema.json",
  "title": "Ash App user color theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "label",
    "colorScheme",
    "colors"
  ],
  "properties": {
    "$schema": {
      "const": "https://ash.dev/schemas/app/color-theme.schema.json"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "colorScheme": {
      "enum": [
        "dark",
        "light",
        "high-contrast-dark",
        "high-contrast-light"
      ]
    },
    "colors": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/colorValue"
      },
      "description": "Color identifiers are validated against this application’s theme catalog."
    }
  },
  "$defs": {
    "colorValue": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[a-z][a-zA-Z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)*)$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "transparent"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "lighten"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "darken"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "other",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "mix"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "other": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "background"
          ],
          "properties": {
            "op": {
              "const": "opaque"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "background": {
              "$ref": "#/$defs/colorValue"
            }
          }
        }
      ]
    }
  }
}
