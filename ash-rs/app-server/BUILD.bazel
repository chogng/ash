load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")

_APP_SERVER_ALIASES = {
    "//ash-rs/collaboration-mode-templates": "collaboration_mode_templates",
    "//ash-rs/screen-capture": "screen_capture",
}

ash_rust_crate(
    name = "app-server",
    crate_name = "ash_app_server",
    data = glob(["templates/**"]) + ["//ash-rs/utils/audio:tests/fixtures/tone.wav"],
    extra_aliases = _APP_SERVER_ALIASES,
)

ash_rust_binary(
    name = "ash-app-server",
    crate_name = "ash_app_server",
    crate_root = "src/main.rs",
    deps = [":app-server"],
    extra_aliases = _APP_SERVER_ALIASES,
)
