{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelCatalog",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StaticModelSpec"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "models"
  ],
  "$defs": {
    "ModelAcceleration": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "service_tier": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "service_tier"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "service_tier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "speed": {
              "$ref": "#/$defs/ModelSpeed"
            },
            "type": {
              "type": "string",
              "const": "speed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "speed",
            "name",
            "description"
          ]
        },
        {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/ModelId"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "model"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "model",
            "name",
            "description"
          ]
        }
      ]
    },
    "ModelCapabilitiesDeclaration": {
      "type": "object",
      "properties": {
        "fast_mode": {
          "description": "Whether acceleration is supported; settings.acceleration declares the request mechanism.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "image_detail_original": {
          "description": "Whether original-detail image requests are supported; image input is declared separately.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "parallel_tool_calls": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tools": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ModelId": {
      "type": "string"
    },
    "ModelInputModality": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio"
      ]
    },
    "ModelMessages": {
      "description": "Model-owned prompt text, assembled with runtime instructions before provider encoding.",
      "type": "object",
      "properties": {
        "system_instructions": {
          "description": "Complete model-specific Agent instructions; runtime permission and project instructions are separate.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "system_instructions"
      ]
    },
    "ModelReasoningEffortOption": {
      "description": "A selectable effort and its catalog explanation. Missing copy is unknown metadata;\nthe effort remains a request value and never implies a fixed token budget.",
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "$ref": "#/$defs/ReasoningEffort"
        }
      },
      "additionalProperties": false,
      "required": [
        "effort"
      ]
    },
    "ModelReasoningSummary": {
      "type": "string",
      "enum": [
        "none",
        "auto",
        "concise",
        "detailed"
      ]
    },
    "ModelServiceTier": {
      "description": "A provider service tier ID is a request value; its label and explanation are display metadata.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "ModelSettingsDeclaration": {
      "type": "object",
      "properties": {
        "acceleration": {
          "description": "How the acceleration preference changes a request: tier, speed parameter, or exact model ID.",
          "anyOf": [
            {
              "$ref": "#/$defs/ModelAcceleration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default_reasoning_summary": {
          "description": "Ash's summary default; the string \"none\" suppresses summaries without disabling reasoning.",
          "anyOf": [
            {
              "$ref": "#/$defs/ModelReasoningSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "default_service_tier": {
          "description": "Ash's request default referencing a declared service_tiers ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "default_verbosity": {
          "description": "Ash's request default; requires verbosity=true. This is not an inferred provider default.",
          "anyOf": [
            {
              "$ref": "#/$defs/ModelVerbosity"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_modalities": {
          "description": "Declared input kinds; a declared list must include text. Omission means unknown.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ModelInputModality"
          }
        },
        "reasoning_summary": {
          "description": "Support for returning reasoning summaries, separate from effort and replayable reasoning history.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "service_tiers": {
          "description": "Exact provider tier IDs with display names and explanations; these do not grant account access.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ModelServiceTier"
          }
        },
        "tool_output_limit": {
          "description": "Core's tool-result truncation budget; not a provider inference parameter or output-token limit.",
          "anyOf": [
            {
              "$ref": "#/$defs/ModelToolOutputLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "verbosity": {
          "description": "Support for a verbosity request parameter: true supported, false unsupported, null or omission unknown.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ModelSpeed": {
      "description": "Inference speed is independent of provider scheduling and billing service tiers.",
      "type": "string",
      "enum": [
        "fast"
      ]
    },
    "ModelToolOutputLimit": {
      "description": "Limits model-visible tool text; original durable tool results remain intact.\nToken limits use the shared output utility's UTF-8 byte approximation, not token measurement.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "bytes"
            }
          },
          "required": [
            "mode",
            "limit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "const": "tokens"
            }
          },
          "required": [
            "mode",
            "limit"
          ]
        }
      ]
    },
    "ModelVerbosity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "ReasoningEffort": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "extraHigh",
        "max"
      ]
    },
    "StaticModelSpec": {
      "description": "One row in Ash's bundled JSON model catalog, independent of account access.",
      "type": "object",
      "properties": {
        "auto_compact_token_limit": {
          "description": "Optional model-specific compaction threshold, constrained by the effective execution budget.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "capabilities": {
          "description": "Confirmed model capabilities; omitted members and null mean unknown, not false.",
          "$ref": "#/$defs/ModelCapabilitiesDeclaration"
        },
        "context_window": {
          "description": "Default context budget in tokens; null or omission means unknown, not unlimited.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "default_reasoning_effort": {
          "description": "Ash's default effort; when present it must reference a declared selectable value.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "max_context_window": {
          "description": "Maximum context budget when long context is enabled; omission means no larger budget.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "model_id": {
          "description": "Exact catalog model ID; connection-specific upstream aliases are configured separately.",
          "type": "string"
        },
        "model_messages": {
          "$ref": "#/$defs/ModelMessages"
        },
        "provider_id": {
          "description": "Exact model vendor ID, independent of API-key or subscription connection identity.",
          "type": "string"
        },
        "settings": {
          "description": "Parameter support, Ash defaults, acceleration mechanism, and model-visible tool-result budget.",
          "$ref": "#/$defs/ModelSettingsDeclaration"
        },
        "supported_reasoning_efforts": {
          "description": "Selectable effort values and their display explanations, independent of a fixed token budget.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelReasoningEffortOption"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "display_name",
        "model_messages"
      ]
    }
  }
}
