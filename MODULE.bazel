crate.annotation(
    build_script_data = [
        "@ash_v8_targets//:rusty_v8_archive_for_target",
        "@ash_v8_targets//:rusty_v8_binding_for_target",
    ],
    build_script_env = {
        "RUSTY_V8_ARCHIVE": "$(execpath @ash_v8_targets//:rusty_v8_archive_for_target)",
        "RUSTY_V8_SRC_BINDING_PATH": "$(execpath @ash_v8_targets//:rusty_v8_binding_for_target)",
        "RUSTY_V8_USE_OUT_DIR": "1",
    },
    crate = "v8",
    crate_features_select = {
        "aarch64-apple-darwin": ["v8_enable_sandbox"],
        "aarch64-pc-windows-msvc": ["v8_enable_sandbox"],
        "aarch64-unknown-linux-gnu": ["v8_enable_sandbox"],
        "aarch64-unknown-linux-musl": ["v8_enable_sandbox"],
        "x86_64-apple-darwin": ["v8_enable_sandbox"],
        "x86_64-pc-windows-msvc": ["v8_enable_sandbox"],
        "x86_64-unknown-linux-gnu": ["v8_enable_sandbox"],
        "x86_64-unknown-linux-musl": ["v8_enable_sandbox"],
    },
    gen_build_script = "on",
    patch_args = ["-p1"],
    patches = ["//bazel/toolchains:v8_bazel_build_dir.patch"],
)

