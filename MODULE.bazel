module(name = "ash")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_rs", version = "0.0.96")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_platform", version = "0.1.0")
bazel_dep(name = "rules_python", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.1.0")
bazel_dep(name = "llvm", version = "0.8.11")
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.1")

# V8's Chromium libc++ must supply both headers and runtime objects throughout
# its source closure, including ICU/Abseil and the host snapshot generators.
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//third_party/v8/patches:llvm_rusty_v8_custom_libcxx.patch"],
)

single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = [
        "//third_party/v8/patches:rules_cc_rusty_v8_custom_libcxx.patch",
        "//bazel/toolchains:rules_cc_windows_build_tools.patch",
    ],
)

single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = ["//third_party/rules_rs:windows_gnullvm_exec_triples.patch"],
)

register_toolchains("@llvm//toolchain:all")

# Standalone Windows V8 hosts select the installed MSVC toolchain explicitly.
# LLVM's Windows toolchain currently only implements the GNU C++ ABI.
cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

# `rules_rust` needs a macOS sysroot even for pure Rust crates. Pin the same
# hermetic Command Line Tools SDK used by Codex so local and CI builds do not
# depend on whichever Xcode happens to be installed.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.from_archive(
    sha256 = "5f044578cd78a3a9b9c965a42d56bad609ee5d252e1d4e6aa7c42fc3f35fee7b",
    strip_prefix = "Payload/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
    type = "pkg",
    urls = [
        "https://swcdn.apple.com/content/downloads/09/08/047-91568-A_Y1CFZWQCD4/4xekpyz43i26dbp4enxfro8eb1q7wiujh5/CLTools_macOSNMOS_SDK.pkg",
    ],
)
osx.frameworks(names = [
    "ApplicationServices",
    "AppKit",
    "ColorSync",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "CoreMedia",
    "CoreMIDI",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "DiskArbitration",
    "AudioToolbox",
    "AVFoundation",
    "AVFAudio",
    "AVRouting",
    "Carbon",
    "CFNetwork",
    "FontServices",
    "AudioUnit",
    "CoreAudio",
    "CoreAudioTypes",
    "Foundation",
    "ImageIO",
    "IOSurface",
    "IOKit",
    "Kernel",
    "Metal",
    "MetalKit",
    "OpenGL",
    "OSLog",
    "QuartzCore",
    "ScreenCaptureKit",
    "Security",
    "SystemConfiguration",
    "UniformTypeIdentifiers",
    "VideoToolbox",
])
# MXC's Seatbelt runner uses libproc to identify and reap workload descendants.
osx.libraries(names = ["libproc", "libsandbox"])
use_repo(osx, "macos_sdk")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
rules_rust.patch(
    patches = [
        "//third_party/rules_rs:rust_macos_rtlib.patch",
        "//third_party/rules_rs:rust_unwind_link_flags.patch",
    ],
    strip = 1,
)
use_repo(rules_rust, "rules_rust")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
RUST_VERSION = "1.98.0"
toolchains.toolchain(
    edition = "2024",
    version = RUST_VERSION,
)
use_repo(toolchains, "default_rust_toolchains")

# Reuse the complete upstream tools layout so GNU Cargo finds libunwind.dll
# beside its executable. These repositories supply files, not registrations;
# rules_rs continues to own the default GNU compiler selection.
rust_tools = use_repo_rule("@rules_rust//rust/private:repositories.bzl", "rust_toolchain_tools_repository")
[
    rust_tools(
        name = "ash_gnullvm_" + cpu + "_tools",
        exec_triple = cpu + "-pc-windows-gnullvm",
        target_triple = cpu + "-pc-windows-gnullvm",
        version = RUST_VERSION,
    )
    for cpu in ["x86_64", "aarch64"]
]
override_repo(
    toolchains,
    cargo_windows_x86_64_1_98_0 = "ash_gnullvm_x86_64_tools",
    cargo_windows_aarch64_1_98_0 = "ash_gnullvm_aarch64_tools",
)

# Reuse rules_rust's repository sets for MSVC-hosted compilers without changing
# the existing GNU execution toolchains or their Cargo repository layout.
msvc_rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
msvc_rust.toolchain(edition = "2024", versions = [RUST_VERSION])
[
    msvc_rust.repository_set(
        name = "ash_msvc_" + cpu,
        edition = "2024",
        exec_triple = cpu + "-pc-windows-msvc",
        exec_compatible_with = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:windows",
            "@llvm//constraints/windows/abi:msvc",
        ],
        target_triple = cpu + "-pc-windows-msvc",
        target_compatible_with = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:windows",
            "@llvm//constraints/windows/abi:msvc",
        ],
        versions = [RUST_VERSION],
    )
    for cpu in ["x86_64", "aarch64"]
]
msvc_rust.repository_set(
    name = "ash_msvc_x86_64",
    target_triple = "aarch64-pc-windows-msvc",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
)
use_repo(msvc_rust, "rust_toolchains")
register_toolchains("@default_rust_toolchains//:all", "@rust_toolchains//:all")

# aws-lc-sys uses pre-generated Rust bindings through rules_rust's hermetic
# bindgen toolchain. Keep the toolchain registration beside the other global
# toolchain registrations, while the project-owned bridge lives in bazel/.
rules_rust_bindgen = use_extension(
    "@rules_rs//rs:rules_rust_bindgen.bzl",
    "rules_rust_bindgen",
)
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "aarch64-pc-windows-gnullvm",
        "aarch64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "x86_64-pc-windows-gnullvm",
        "x86_64-pc-windows-msvc",
    ],
)
use_repo(crate, "crates")

# rules_rust's runfiles crate has its own manifest below the repository root.
crate.annotation(
    crate = "runfiles",
    workspace_cargo_toml = "rust/runfiles/Cargo.toml",
)

# The consolidated SDK stamps its Windows helper binaries during its build.
# Use the existing LLVM toolchain for resources rather than a host Windows SDK.
crate.annotation(
    crate = "mxc-sdk",
    build_script_tools = ["@llvm//tools:llvm-rc"],
    build_script_env = {
        "RC_PATH": "$(execpath @llvm//tools:llvm-rc)",
    },
    repositories = ["crates"],
)

crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    repositories = ["crates"],
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    deps = ["@crates//:aws_lc_sys_build_info"],
)
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
    repositories = ["crates"],
)

inject_repo(crate, "aws-lc")

# The V8 crate build script consumes checksum-pinned sandbox-enabled archives and bindings.
# They are build inputs only: the resulting executables link V8 statically.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

