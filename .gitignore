# Canonical local build products
.build/

# Legacy output paths remain ignored so older tools cannot re-add them.
target/
__pycache__/
*.py[cod]

# Bazel creates these workspace-root symlinks for its output tree.
/bazel-*
/user.bazelrc

# Per-workspace runtime state
.ash/
.playwright-*/
.temp
.tmp/
.snow
output/
!app-ts/src/ash/workbench/contrib/output/
!app-ts/src/ash/workbench/contrib/output/**
!app-ts/src/ash/workbench/services/output/
!app-ts/src/ash/workbench/services/output/**

# Legacy Desktop build products
app-ts/node_modules/
app-ts/dist/
app-ts/test/integration/browser/dist/
app-ts/.tmp/
app-ts/debug.log
node_modules/
.pnpm-store/
app-ts/src/ash/platform/app-server/common/generated/
schemas/app-server/

# Downloaded, checksum-verified third-party native runtime artifacts.
third_party/.cache/


.DS_Store
.tmp-editor-file-audit.txt
.tmp-typecheck-editor.txt
scripts/.venv
