# Canonical local build products
.build/

# Legacy output paths remain ignored so older tools cannot re-add them.
target/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Bazel creates these workspace-root symlinks for its output tree.
/bazel-*
/user.bazelrc

# Per-workspace runtime state
.ash/
.playwright-*/
.temp
.tmp/
.snow
output/
!src/ash/workbench/contrib/output/
!src/ash/workbench/contrib/output/**
!src/ash/workbench/services/output/
!src/ash/workbench/services/output/**

# Frontend dependencies and generated files
node_modules/
dist/
debug.log
.pnpm-store/
src/ash/platform/extensions/common/generated/
schemas/app-server/

# Downloaded, checksum-verified third-party native runtime artifacts.
third_party/.cache/

.DS_Store
.tmp-editor-file-audit.txt
.tmp-typecheck-editor.txt
scripts/.venv
