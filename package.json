{
  "name": "ash",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=25 <26"
  },
  "scripts": {
    "preinstall": "node build/pnpm/preinstall.ts",
    "build": "corepack pnpm run build:desktop",
    "build:desktop": "corepack pnpm --dir ash-ts build",
    "build:stanza": "corepack pnpm --dir ash-ts build:stanza",
    "clean": "node build/clean.ts",
    "icons:generate": "node build/resources/icons/generate.ts",
    "icons:check": "node build/resources/icons/generate.ts --check",
    "test": "corepack pnpm run verify:protocol && corepack pnpm --dir ash-ts run test:main",
    "test:build": "corepack pnpm --dir build test",
    "test:integration": "corepack pnpm --dir ash-ts run test:editor:browser",
    "test:icons": "node --test build/resources/icons/generate.test.ts",
    "test:web-integration": "corepack pnpm --dir ash-ts run test:smoke:browser:full",
    "test:extensions": "corepack pnpm --dir ash-ts run test:extensions",
    "test:desktop:editor": "corepack pnpm --dir ash-ts run test:editor",
    "test:desktop:app": "corepack pnpm --dir ash-ts test:app",
    "test:desktop:app:pdf-corpus": "corepack pnpm --dir ash-ts test:app:pdf-corpus",
    "test:desktop:smoke": "corepack pnpm --dir ash-ts run test:smoke:desktop",
    "test:desktop:smoke:ui": "corepack pnpm --dir ash-ts test:smoke:ui",
    "test:desktop:smoke:browser": "corepack pnpm --dir ash-ts test:smoke:browser",
    "test:desktop:smoke:browser:full": "corepack pnpm --dir ash-ts run test:smoke:browser:full",
    "test:desktop:e2e": "corepack pnpm --dir ash-ts run test:smoke:desktop",
    "typecheck:build": "corepack pnpm --dir build typecheck",
    "typecheck:stanza": "corepack pnpm --dir ash-ts typecheck:stanza",
    "dev:desktop": "corepack pnpm --dir ash-ts dev",
    "dev:stanza": "corepack pnpm --dir ash-ts dev:stanza",
    "dev:desktop:ui": "corepack pnpm --dir ash-ts dev:ui",
    "dev:desktop:rust": "corepack pnpm --dir ash-ts dev:rust",
    "dev:web": "corepack pnpm --dir ash-ts dev:web",
    "dev:web:full": "corepack pnpm --dir ash-ts dev:web:full",
    "fetch:pdfium": "node build/download/fetchPdfium.ts",
    "package:ash": "just package",
    "generate:protocol": "just generate-protocol",
    "verify:protocol": "cargo test --manifest-path Cargo.toml -p ash-app-server-protocol"
  }
}
