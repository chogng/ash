{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prepare Ash Code Debug",
			"type": "process",
			"command": "node",
			"args": ["build/python.ts", "-B", "build/code/debug.py"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"runOptions": { "instanceLimit": 1 }
		},
		{
			"label": "Build Ash Debug Backend",
			"type": "shell",
			"command": "pnpm debug:backend",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Watch Ash Backend",
			"type": "process",
			"command": "node",
			"args": ["build/desktop/watch-app-server.ts", "--skip-initial"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "rust",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[app-server\\] Watching Rust App Server sources$",
					"endsPattern": "^\\[app-server\\] Watching Rust App Server sources$"
				}
			},
			"presentation": {
				"panel": "dedicated",
				"group": "ash-desktop-debug"
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Run Ash Desktop Renderer",
			"type": "shell",
			"command": "pnpm dev:renderer --port 5183",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": "Local:.*http://127\\.0\\.0\\.1:5183/"
				}
			},
			"presentation": {
				"panel": "dedicated",
				"group": "ash-desktop-debug"
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Prepare Ash Web",
			"type": "shell",
			"command": "pnpm prepare:generated",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"group": "ash-browser-ui"
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Watch Ash Web Types",
			"type": "shell",
			"command": "pnpm typecheck:web:watch",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
			"presentation": {
				"panel": "dedicated",
				"group": "ash-browser-ui"
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Prepare Ash Backend",
			"type": "shell",
			"command": "pnpm prepare:backend",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"clear": true
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Run Ash Web",
			"type": "shell",
			"command": "pnpm dev:web",
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": {
				"owner": "vite",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": "(Local|Network):.*"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"group": "ash-browser-ui",
				"clear": true
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Run Ash Server (Web)",
			"type": "shell",
			"command": "pnpm dev:web:full",
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": {
				"owner": "vite",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": "(Local|Network):.*"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"group": "ash-browser-ui",
				"clear": true
			},
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Launch Stanza Vite",
			"type": "shell",
			"command": "pnpm run dev:stanza",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": "(Local|Network):.*"
				}
			}
		}
	]
}
