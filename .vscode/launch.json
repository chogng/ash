{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Ash",
			"type": "node-terminal",
			"request": "launch",
			"command": "bash ./scripts/ash.sh",
			"windows": {
				"command": "cmd /d /c .\\scripts\\ash.bat"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash",
				"order": 1
			}
		},
		{
			"name": "Ash Agents",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev:agents",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash",
				"order": 2
			}
		},
		{
			"name": "Ash (Hot Reload)",
			"type": "node-terminal",
			"request": "launch",
			"command": "bash ./scripts/ash.sh --connected",
			"windows": {
				"command": "cmd /d /c .\\scripts\\ash.bat --connected"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash",
				"order": 3
			}
		},
		{
			"name": "Ash Server (Web)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web Backend",
			"console": "internalConsole",
			"outputCapture": "std",
			"presentation": {
				"group": "0_ash",
				"order": 4
			}
		},
		{
			"name": "Ash Server (Web, Chrome)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web Backend",
			"console": "internalConsole",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Open Ash: (http://[^\\s\\u001b]+)",
				"action": "debugWithChrome",
				"uriFormat": "%s",
				"webRoot": "${workspaceFolder}",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 5
			}
		},
		{
			"name": "Ash Server (Web, Edge)",
			"type": "node",
