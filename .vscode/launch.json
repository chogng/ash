{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Ash Code (TUI)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just ash",
			"osx": {
				"command": "uv run --python 3.12 just ash"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash_code",
				"order": 1
			}
		},
		{
			"name": "Ash (Electron)",
			"type": "node-terminal",
			"request": "launch",
			"command": "bash ./scripts/ash-desktop.sh",
			"windows": {
				"command": "cmd /d /c .\\scripts\\ash-desktop.bat"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 1
			}
		},
		{
			"name": "Ash (Electron, Frontend Watch Only)",
			"type": "node-terminal",
			"request": "launch",
			"command": "bash ./scripts/ash-desktop.sh --connected",
			"windows": {
				"command": "cmd /d /c .\\scripts\\ash-desktop.bat --connected"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 2
			}
		},
		{
			"name": "Ash (Electron, Agents)",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev:agents",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 3
			},
			"osx": {
				"command": "uv run --python 3.12 pnpm dev:agents"
			}
		},
		{
			"name": "Ash Web (Chrome)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "0",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "internalConsole",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Local:\\s+(http://127\\.0\\.0\\.1:5173/)",
				"action": "startDebugging",
				"name": "Ash Web Browser (Chrome)",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "1_ash_desktop",
				"order": 3
			}
		},
		{
			"name": "Ash Web Browser (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5173/",
			"webRoot": "${workspaceFolder}",
			"cascadeTerminateToConfigurations": [
				"Ash Web (Chrome)"
			],
			"presentation": {
				"hidden": true
			}
		},
		{
			"name": "Ash Sessions Web (Chrome)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"ASH_DEV_AGENTS_WINDOW": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web Backend",
			"console": "internalConsole",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Open Ash: (http://[^\\s\\u001b]+)",
				"action": "debugWithChrome",
				"uriFormat": "%s",
				"webRoot": "${workspaceFolder}",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "1_ash_desktop",
				"order": 4
			}
		},
		{
			"name": "Ash Sessions Web (Chrome, UI Only)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "0",
				"ASH_DEV_AGENTS_WINDOW": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "internalConsole",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Local:\\s+(http://127\\.0\\.0\\.1:5173/)",
				"action": "startDebugging",
				"name": "Ash Sessions Web Browser (Chrome)",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "1_ash_desktop",
				"order": 5
			}
		},
		{
			"name": "Ash Sessions Web Browser (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5173/",
			"webRoot": "${workspaceFolder}",
			"cascadeTerminateToConfigurations": [
				"Ash Sessions Web (Chrome, UI Only)"
			],
			"presentation": {
				"hidden": true
			}
		},
		{
			"name": "Stanza Editor - Standalone",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5199/",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Launch Stanza Vite",
			"presentation": {
				"group": "3_stanza",
				"order": 1
			}
		}
	]
}
