{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Ash Desktop (TypeScript)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just ash-desktop",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "ash-desktop",
				"order": 1
			}
		},
		{
			"name": "Run Ash Code",
			"type": "node-terminal",
			"request": "launch",
			"command": "just ash",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "ash-code",
				"order": 1
			}
		},
		{
			"name": "Run app",
			"type": "node-terminal",
			"request": "launch",
			"command": "just app",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "app",
				"order": 1
			}
		},
		{
			"name": "Stanza Editor - Standalone",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5199/build/desktop/vite/stanza/index.html",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Launch Stanza Vite",
			"presentation": {
				"group": "stanza",
				"order": 1
			}
		}
	]
}
