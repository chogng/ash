{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Ash Code (TUI)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just ash",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash_code",
				"order": 1
			}
		},
		{
			"name": "Ash Desktop (Electron)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just ash-desktop",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 1
			}
		},
		{
			"name": "Ash Desktop UI (reuse App Server)",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm --dir app-ts dev:ui:connected",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 2
			}
		},
		{
			"name": "App (Rust Desktop)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just app",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "2_app",
				"order": 1
			}
		},
		{
			"name": "Stanza Editor - Standalone",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5199/build/app_ts/vite/stanza/index.html",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Launch Stanza Vite",
			"presentation": {
				"group": "3_stanza",
				"order": 1
			}
		}
	]
}
