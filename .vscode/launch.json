{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Ash Dev Terminal",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev",
			"autoAttachChildProcesses": true,
			"cwd": "${workspaceFolder}",
			"presentation": { "group": "0_ash", "order": 20 }
		},
		{
			"name": "Ash Agents Dev Terminal",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev:agents",
			"autoAttachChildProcesses": true,
			"cwd": "${workspaceFolder}",
			"presentation": { "group": "0_ash", "order": 21 }
		},
		{
			"name": "Ash Hot Reload Dev Terminal",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev:ui:connected",
			"autoAttachChildProcesses": true,
			"cwd": "${workspaceFolder}",
			"presentation": { "group": "0_ash", "order": 22 }
		},
		{
			"name": "Ash",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash",
				"order": 1
			},
			"runtimeExecutable": "node",
			"program": "${workspaceFolder}/build/desktop/launch/electron.ts",
			"args": [
				"--watch",
				"--inspect-brk=127.0.0.1:9229",
				"--remote-debugging-address=127.0.0.1",
				"--remote-debugging-port=9222",
				"--user-data-dir=${workspaceFolder}/.build/desktop/debug/user-data",
				"--folder=${workspaceFolder}"
			],
			"autoAttachChildProcesses": false,
			"outFiles": ["${workspaceFolder}/.build/desktop/main/**/*.js"],
			"console": "integratedTerminal",
			"preLaunchTask": "Prepare Ash Desktop Debug",
			"env": {
				"ASH_RENDERER_URL": "http://127.0.0.1:5183",
				"ASH_HOME": "${workspaceFolder}/.build/desktop/debug/profile"
			},
			"outputCapture": "std",
			"serverReadyAction": {
				"action": "startDebugging",
				"pattern": "Ash Electron debug target: 127[.]0[.]0[.]1:(9229)",
				"name": "Ash Main Process",
				"killOnServerStop": true
			}
		},
		{
			"name": "Ash Agents",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash",
				"order": 2
			},
			"runtimeExecutable": "node",
			"program": "${workspaceFolder}/build/desktop/launch/electron.ts",
			"args": [
				"--watch",
				"--inspect-brk=127.0.0.1:9229",
				"--remote-debugging-address=127.0.0.1",
				"--remote-debugging-port=9222",
				"--user-data-dir=${workspaceFolder}/.build/desktop/debug/user-data",
				"--folder=${workspaceFolder}"
			],
			"autoAttachChildProcesses": false,
			"outFiles": ["${workspaceFolder}/.build/desktop/main/**/*.js"],
			"console": "integratedTerminal",
			"preLaunchTask": "Prepare Ash Desktop Debug",
			"env": {
				"ASH_RENDERER_URL": "http://127.0.0.1:5183",
				"ASH_HOME": "${workspaceFolder}/.build/desktop/debug/profile",
				"ASH_DEV_AGENTS_WINDOW": "1"
			},
			"outputCapture": "std",
			"serverReadyAction": {
				"action": "startDebugging",
				"pattern": "Ash Electron debug target: 127[.]0[.]0[.]1:(9229)",
				"name": "Ash Main Process",
				"killOnServerStop": true
			}
		},
		{
			"name": "Ash (Hot Reload)",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash",
				"order": 3
			},
			"runtimeExecutable": "node",
			"program": "${workspaceFolder}/build/desktop/launch/electron.ts",
			"args": [
				"--watch",
				"--inspect-brk=127.0.0.1:9229",
				"--remote-debugging-address=127.0.0.1",
				"--remote-debugging-port=9222",
				"--user-data-dir=${workspaceFolder}/.build/desktop/debug/user-data",
				"--folder=${workspaceFolder}"
			],
			"autoAttachChildProcesses": false,
			"outFiles": ["${workspaceFolder}/.build/desktop/main/**/*.js"],
			"console": "integratedTerminal",
			"preLaunchTask": "Prepare Ash Desktop Debug",
			"env": {
				"ASH_RENDERER_URL": "http://127.0.0.1:5183",
				"ASH_HOME": "${workspaceFolder}/.build/desktop/debug/profile",
				"ASH_DEV_APP_SERVER_RELOAD": "1"
			},
			"outputCapture": "std",
			"serverReadyAction": {
				"action": "startDebugging",
				"pattern": "Ash Electron debug target: 127[.]0[.]0[.]1:(9229)",
				"name": "Ash Main Process",
				"killOnServerStop": true
			}
		},
		{
			"name": "Ash Main Process",
			"type": "node",
			"request": "attach",
			"address": "127.0.0.1",
			"port": 9229,
			"continueOnAttach": true,
			"autoAttachChildProcesses": false,
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/.build/desktop/main/**/*.js"],
			"presentation": {
				"group": "0_ash",
				"order": 4
			},
			"cwd": "${workspaceFolder}",
			"runtimeSourcemapPausePatterns": [
				"${workspaceFolder}/.build/desktop/main/**/*.js"
			],
			"restart": true
		},
		{
			"name": "Ash Renderer",
			"type": "chrome",
			"request": "attach",
			"address": "127.0.0.1",
			"port": 9222,
			"urlFilter": "*electron-browser/workbench/workbench.html*",
			"webRoot": "${workspaceFolder}/src/ash/code",
			"sourceMaps": true,
			"timeout": 30000,
			"presentation": {
				"group": "0_ash",
				"order": 4
			}
		},
		{
			"name": "Ash Agents Renderer",
			"type": "chrome",
			"request": "attach",
			"address": "127.0.0.1",
			"port": 9222,
			"urlFilter": "*sessions/electron-browser/sessions.html*",
			"webRoot": "${workspaceFolder}/src/ash/code",
			"sourceMaps": true,
			"timeout": 30000,
			"presentation": {
				"group": "0_ash",
				"order": 5
			}
		},
		{
			"name": "Ash (Native Debug)",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "node",
			"program": "${workspaceFolder}/build/desktop/launch/electron.ts",
			"args": [
				"--watch",
				"--inspect-brk=127.0.0.1:9229",
				"--remote-debugging-address=127.0.0.1",
				"--remote-debugging-port=9222",
				"--user-data-dir=${workspaceFolder}/.build/desktop/debug/user-data",
				"--folder=${workspaceFolder}"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_RENDERER_URL": "http://127.0.0.1:5183",
				"ASH_HOME": "${workspaceFolder}/.build/desktop/debug/profile",
				"ASH_DEV_APP_SERVER_GENERATION": "${workspaceFolder}/.build/desktop/debug/app-server/current.json"
			},
			"autoAttachChildProcesses": false,
			"outFiles": ["${workspaceFolder}/.build/desktop/main/**/*.js"],
			"console": "integratedTerminal",
			"preLaunchTask": "Prepare Ash Native Debug",
			"presentation": {
				"group": "0_ash",
				"order": 6
			},
			"outputCapture": "std",
			"serverReadyAction": {
				"action": "startDebugging",
				"pattern": "Ash Electron debug target: 127[.]0[.]0[.]1:(9229)",
				"name": "Ash Main Process",
				"killOnServerStop": true
			}
		},
		{
			"name": "Ash App Server (Attach)",
			"type": "lldb",
			"request": "attach",
			"pid": "${input:ashAppServerPid}",
			"sourceLanguages": ["rust"],
			"presentation": {
				"group": "0_ash",
				"order": 7
			},
			"stopOnEntry": false,
			"_adapterSettings": {
				"dereferencePointers": false
			},
			"preRunCommands": [
				"script import lldb_lookup; lldb_lookup.RUST_CATEGORY.DeleteTypeSummary(lldb.SBTypeNameSpecifier(lldb_lookup.MOD_PREFIX + 'is_udt', lldb.eFormatterMatchCallback))"
			]
		},
		{
			"name": "Ash Server (Web)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5185"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"presentation": {
				"group": "0_ash",
				"order": 4
			}
		},
		{
			"name": "Ash Server (Web, Chrome)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5185"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Open Ash: (http://[^\\s\\u001b]+)",
				"action": "debugWithChrome",
				"uriFormat": "%s",
				"webRoot": "${workspaceFolder}/src/ash/code",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 5
			}
		},
		{
			"name": "Ash Server (Web, Edge)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5185"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Open Ash: (http://[^\\s\\u001b]+)",
				"action": "debugWithEdge",
				"uriFormat": "%s",
				"webRoot": "${workspaceFolder}/src/ash/code",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 6
			}
		},
		{
			"name": "Ash Agents Server (Web, Chrome)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5187"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"ASH_DEV_AGENTS_WINDOW": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Open Ash: (http://[^\\s\\u001b]+)",
				"action": "debugWithChrome",
				"uriFormat": "%s",
				"webRoot": "${workspaceFolder}/src/ash/code",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 7
			}
		},
		{
			"name": "Ash Agents Server (Web, Edge)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5187"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "1",
				"ASH_DEV_AGENTS_WINDOW": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Open Ash: (http://[^\\s\\u001b]+)",
				"action": "debugWithEdge",
				"uriFormat": "%s",
				"webRoot": "${workspaceFolder}/src/ash/code",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 8
			}
		},
		{
			"name": "Ash Web (Chrome)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5184"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "0",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Local:.*(http://127[.]0[.]0[.]1:5184/)",
				"action": "startDebugging",
				"name": "Ash Web Browser (Chrome)",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 9
			}
		},
		{
			"name": "Ash Web (Edge)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5184"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "0",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Local:.*(http://127[.]0[.]0[.]1:5184/)",
				"action": "startDebugging",
				"name": "Ash Web Browser (Edge)",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 10
