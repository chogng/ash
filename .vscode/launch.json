{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Ash Code (TUI)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just ash",
			"osx": {
				"command": "uv run --python 3.12 just ash"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "0_ash_code",
				"order": 1
			}
		},
		{
			"name": "Ash (Electron)",
			"type": "node-terminal",
			"request": "launch",
			"command": "bash ./scripts/ash-desktop.sh",
			"windows": {
				"command": "cmd /d /c .\\scripts\\ash-desktop.bat"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 1
			}
		},
		{
			"name": "Ash (Electron, Frontend Watch Only)",
			"type": "node-terminal",
			"request": "launch",
			"command": "bash ./scripts/ash-desktop.sh --connected",
			"windows": {
				"command": "cmd /d /c .\\scripts\\ash-desktop.bat --connected"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 2
			}
		},
		{
			"name": "Ash Web (Chrome, UI Only)",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5173/",
			"webRoot": "${workspaceFolder}/app-ts/src/ash/code",
			"preLaunchTask": "Run Ash Web (UI Only)",
			"presentation": {
				"group": "1_ash_desktop",
				"order": 3
			}
		},
		{
			"name": "Ash App (Rust)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just app",
			"osx": {
				"command": "uv run --python 3.12 just app"
			},
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "2_app",
				"order": 1
			}
		},
		{
			"name": "Stanza Editor - Standalone",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5199/build/app_ts/vite/stanza/index.html",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Launch Stanza Vite",
			"presentation": {
				"group": "3_stanza",
				"order": 1
			}
		}
	]
}
