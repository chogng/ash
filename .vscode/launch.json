			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5186"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "0",
				"ASH_DEV_AGENTS_WINDOW": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Local:.*(http://127[.]0[.]0[.]1:5186/)",
				"action": "startDebugging",
				"name": "Ash Agents Web Browser (Chrome)",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 11
			}
		},
		{
			"name": "Ash Agents Web (Edge)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
			"args": [
				"--config",
				"build/desktop/vite/vite.config.ts",
				"--mode",
				"web",
				"--port",
				"5186"
			],
			"cwd": "${workspaceFolder}",
			"env": {
				"ASH_WEB_APP_SERVER": "0",
				"ASH_DEV_AGENTS_WINDOW": "1",
				"NO_COLOR": "1"
			},
			"preLaunchTask": "Prepare Ash Web",
			"console": "integratedTerminal",
			"outputCapture": "std",
			"serverReadyAction": {
				"pattern": "Local:.*(http://127[.]0[.]0[.]1:5186/)",
				"action": "startDebugging",
				"name": "Ash Agents Web Browser (Edge)",
				"killOnServerStop": true
			},
			"presentation": {
				"group": "0_ash",
				"order": 12
			}
		},
		{
			"name": "Ash Code (TUI)",
			"envFile": "${workspaceFolder}/.build/code/debug.env",
			"type": "lldb",
			"request": "launch",
			"program": "${workspaceFolder}/.build/cargo/ci-test/ash",
			"windows": {
				"program": "${workspaceFolder}/.build/cargo/ci-test/ash.exe",
				"env": {
					"ASH_APP_SERVER_PATH": "${workspaceFolder}/.build/cargo/ci-test/ash-app-server.exe",
					"ASH_CODE_MODE_HOST_BIN": "${workspaceFolder}/.build/cargo/ci-test/ash-code-mode-host.exe",
					"ASH_PRODUCT_SERVICES_PATH": "${workspaceFolder}/resources/product-services/product-services.json"
				}
			},
			"env": {
				"ASH_APP_SERVER_PATH": "${workspaceFolder}/.build/cargo/ci-test/ash-app-server",
				"ASH_CODE_MODE_HOST_BIN": "${workspaceFolder}/.build/cargo/ci-test/ash-code-mode-host",
				"ASH_PRODUCT_SERVICES_PATH": "${workspaceFolder}/resources/product-services/product-services.json"
			},
			"args": [],
			"terminal": "integrated",
			"sourceLanguages": ["rust"],
			"preLaunchTask": "Prepare Ash Code Debug",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "1_ash_code",
				"order": 1
			}
		},
		{
			"name": "Stanza Editor (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5199/",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Launch Stanza Vite",
			"presentation": {
				"group": "2_stanza",
				"order": 1
			}
		},
		{
			"name": "Stanza Editor (Edge)",
			"type": "msedge",
			"request": "launch",
			"url": "http://127.0.0.1:5199/",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Launch Stanza Vite",
			"presentation": {
				"group": "2_stanza",
				"order": 1
			}
		},
		{
			"name": "Ash Web Browser (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5184/browser/workbench/workbench.html",
			"webRoot": "${workspaceFolder}/src/ash/code",
			"cascadeTerminateToConfigurations": ["Ash Web (Chrome)"],
			"presentation": {
				"hidden": true
			},
			"osx": {
				"runtimeArgs": ["--use-mock-keychain"]
			}
		},
		{
			"name": "Ash Web Browser (Edge)",
			"type": "msedge",
			"request": "launch",
			"url": "http://127.0.0.1:5184/browser/workbench/workbench.html",
			"webRoot": "${workspaceFolder}/src/ash/code",
			"cascadeTerminateToConfigurations": ["Ash Web (Edge)"],
			"presentation": {
				"hidden": true
			},
			"osx": {
				"runtimeArgs": ["--use-mock-keychain"]
			}
		},
