{
	"files.eol": "\n",
	"[typescript][typescriptreact][javascript][javascriptreact]": {
		"editor.defaultFormatter": "vscode.typescript-language-features",
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.formatOnSave": true
	},
	"js/ts.preferences.quoteStyle": "single",
	"js/ts.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": true,
	"js/ts.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": true,
	"js/ts.format.semicolons": "insert",
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer",
		"editor.formatOnSave": true
	},
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true
	},
	"[json][jsonc][yaml][markdown][css][html]": {
		"editor.defaultFormatter": "wdomitrz.simple-lsp-client",
		"editor.formatOnSave": true
	},
	"simpleLspClient.formatters": {
		"bun": {
			"cmd": [
				"${workspaceFolder}/node_modules/bun/bun",
				"fmt",
				"--ignore-path",
				".gitignore",
				"--ignore-path",
				".prettierignore",
				"--stdin-filepath",
				"${file}"
			],
			"filetypes": ["json", "jsonc", "yaml", "markdown", "css", "html"]
		}
	},
	"bazel.commandLine.queryExpression": "//...:*",
	"bazel.queriesShareServer": false,
	"terminal.integrated.env.windows": {
		"PATH": "${workspaceFolder}\\scripts\\.venv\\Scripts;${env:PATH}",
		"NODE_GYP_FORCE_PYTHON": "${workspaceFolder}\\scripts\\.venv\\Scripts\\python.exe"
	},
	"rust-analyzer.cargo.targetDir": ".build/rust-analyzer",
	"rust-analyzer.cachePriming.enable": false,
	"rust-analyzer.cargo.allTargets": false,
	"rust-analyzer.cargo.buildScripts.enable": false,
	"rust-analyzer.check.workspace": false,
	"rust-analyzer.check.allTargets": false,
	"rust-analyzer.check.overrideCommand": [
		"just",
		"check",
		"{label}",
		"--profile",
		"dev",
		"--message-format=json",
		"--target-dir",
		".build/rust-analyzer"
	],
	"rust-analyzer.cargo.buildScripts.overrideCommand": [
		"just",
		"check-workspace",
		"--profile",
		"dev",
		"--message-format=json",
		"--target-dir",
		".build/rust-analyzer"
	]
}
