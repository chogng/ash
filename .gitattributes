# Text files have the same bytes in Windows and Unix checkouts, regardless of core.autocrlf.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep the Just entrypoint in the formatter's canonical line ending.
/justfile text eol=lf

# Unified diff blank context lines require a space prefix.
/crates/vendor/mxc/changes.patch whitespace=-blank-at-eol
/third_party/v8/patches/*.patch whitespace=-blank-at-eol
/third_party/rules_rs/rust_unwind_link_flags.patch whitespace=-blank-at-eol

# Terminal baselines retain blank cells in fixed-width buffers.
/crates/tui/snapshots/inline/output/*.snap whitespace=-blank-at-eol
/crates/tui/snapshots/*/agent_modes/*.snap whitespace=-blank-at-eol

# Embed identical shared prompt assets on every platform.
/crates/prompts/templates/** text eol=lf
/crates/task-command-templates/templates/** text eol=lf
/crates/agent-roles/assets/** text eol=lf
/crates/model-provider-info/models/*.json text eol=lf

# Keep embedded classifier assets identical to their pinned release hashes.
/app-rs/input-classifier/models/*.json text eol=lf
/app-rs/input-classifier/models/*.onnx -text
/app-rs/input-classifier/dictionaries/*.txt text eol=lf

# Keep product icon sources canonical across platforms.
/resources/icons/*.svg text eol=lf
/resources/icons/manifest.json text eol=lf
/app-rs/icons/src/generated.rs text eol=lf
/generated/product-icons.ts text eol=lf

# Full-width terminal frames retain their right-hand padding.
/crates/tui/snapshots/fullscreen/chat_view/configured_statusline_fullscreen.snap whitespace=-blank-at-eol
/crates/tui/snapshots/fullscreen/chat_view/dictation_and_permission_fullscreen.snap whitespace=-blank-at-eol
/crates/tui/snapshots/fullscreen/chat_view/fixed_progress_scrolled_fullscreen.snap whitespace=-blank-at-eol
/crates/tui/snapshots/fullscreen/extensions/extensions_chinese_command_completion.snap whitespace=-blank-at-eol
/crates/tui/snapshots/fullscreen/frame/hooks_slash_completion.snap whitespace=-blank-at-eol
/crates/tui/snapshots/fullscreen/frame/slash_popup_clears_covered_transcript_rows_edge_to_edge.snap whitespace=-blank-at-eol
/crates/tui/snapshots/fullscreen/frame/slash_popup_scrolled_to_last_command.snap whitespace=-blank-at-eol
/crates/tui/snapshots/fullscreen/state/english_punctuation_slash_completion_chinese.snap whitespace=-blank-at-eol
/crates/tui/snapshots/inline/chat_view/configured_statusline_inline.snap whitespace=-blank-at-eol
/crates/tui/snapshots/inline/chat_view/dictation_and_permission_inline.snap whitespace=-blank-at-eol
/crates/tui/snapshots/inline/chat_view/fixed_progress_scrolled_inline.snap whitespace=-blank-at-eol
/crates/tui/snapshots/inline/state/english_punctuation_slash_completion_chinese.snap whitespace=-blank-at-eol
