# Keep the Just entrypoint in the formatter's canonical line ending.
/justfile text eol=lf

# Embed identical shared prompt assets on every platform.
/ash-rs/prompts/templates/** text eol=lf
/ash-rs/agent-roles/assets/** text eol=lf
/ash-rs/models-manager/templates/instructions/** text eol=lf

# Keep embedded classifier assets identical to their pinned release hashes.
/app-rs/input-classifier/models/*.json text eol=lf
/app-rs/input-classifier/models/*.onnx -text
/app-rs/input-classifier/dictionaries/*.txt text eol=lf

# Keep product icon sources canonical across platforms.
/resources/icons/*.svg text eol=lf
/resources/icons/manifest.json text eol=lf
/app-rs/icons/src/generated.rs text eol=lf
/app-ts/generated/product-icons.ts text eol=lf

# Preserve the imported SDK snapshots and upstream patch context byte-for-byte.
/ash-rs/vendor/livekit-rust-sdks/** -text whitespace=-blank-at-eol,-blank-at-eof
