load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")

ash_rust_crate(
    name = "cli",
    crate_name = "ash_cli",
)

ash_rust_binary(
    name = "ash",
    crate_name = "ash",
    crate_root = "src/main.rs",
    deps = [":cli"],
)

_TUI_RUSTC_ENV = {
    "ASH_BAZEL_ASH": "$(rlocationpath :ash)",
    "ASH_BAZEL_APP_SERVER": "$(rlocationpath //ash-rs/app-server:ash-app-server)",
    "ASH_BAZEL_DAEMON": "$(rlocationpath //ash-rs/app-server-daemon:ash-app-server-daemon)",
}

rust_test(
    name = "tui-real-scenarios",
    crate_name = "tui_real_scenarios",
    crate_root = "tests/tui_real_scenarios.rs",
    srcs = glob(["tests/tui/*.rs"]) + [
        "tests/support/scenario_http.rs",
        "tests/support/tui_process.rs",
        "tests/tui_real_scenarios.rs",
    ],
    compile_data = [
        "tests/support/issue_provider.py",
        "//ash-rs/skills:built-in-skills",
    ],
    data = [
        ":ash",
        "//ash-rs/app-server:ash-app-server",
        "//ash-rs/app-server-daemon:ash-app-server-daemon",
    ] + glob(["tests/snapshots/**/*.snap"]) + select({
        "@llvm//platforms/config:linux_aarch64_gnu": ["@llvm//runtimes/libstdcxx:libstdcxx_shared_soname"],
        "@llvm//platforms/config:linux_x86_64_gnu": ["@llvm//runtimes/libstdcxx:libstdcxx_shared_soname"],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(normal = True, normal_dev = True) + [":cli"],
    edition = "2024",
    env_inherit = ["PATH", "ASH_RG_PATH", "ASH_TGREP_PATH"],
    rustc_env = select({
        "@llvm//platforms/config:linux_aarch64_gnu": _TUI_RUSTC_ENV | {
            "ASH_BAZEL_LIBSTDCXX": "$(rlocationpath @llvm//runtimes/libstdcxx:libstdcxx_shared_soname)",
        },
        "@llvm//platforms/config:linux_x86_64_gnu": _TUI_RUSTC_ENV | {
            "ASH_BAZEL_LIBSTDCXX": "$(rlocationpath @llvm//runtimes/libstdcxx:libstdcxx_shared_soname)",
        },
        "//conditions:default": _TUI_RUSTC_ENV,
    }),
    rustc_env_files = ["//:workspace-version-env"],
    timeout = "long",
)

multiplatform_binaries(name = "ash")
