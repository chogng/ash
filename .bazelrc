# Keep local configuration outside version control.
try-import %workspace%/user.bazelrc

common --enable_platform_specific_config
common --incompatible_strict_action_env
common --test_output=errors
common --symlink_prefix=.build/bazel-

# Persist local Rust action results across Bazel server/output-base churn. The
# workspace build directory is already ignored by Git and keeps this cache
# separate from the hermetic repository inputs.
common --disk_cache=.build/bazel-disk-cache

# Do not probe the machine's Xcode installation; the SDK is supplied by
# MODULE.bazel and the LLVM toolchain.
common --xcode_version_config=//:disable_xcode

# Keep Linux and Windows host tools aligned with the hermetic target ABI.
# rules_rs is patched to use gnullvm-hosted Rust tools on Windows so rustc,
# proc-macro DLLs, and the LLVM/MinGW linker share one ABI.
common:linux --host_platform=//:local_linux
common:windows --host_platform=//:local_windows

# Use the hermetic LLVM toolchain registered in MODULE.bazel instead of
# discovering a machine-specific Apple C++ toolchain.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1

# Artifact identity checks rehash complete programs during test startup. Keep the
# sha2 0.10 dependency optimized like Cargo's test profile; do not skip validation
# or override release builds. The filter is a rules_rs crate-root path prefix.
test:ci --compilation_mode=fastbuild
test:ci --@rules_rust//rust/settings:experimental_per_crate_rustc_flag=external/rules_rs++crate+crates__sha2-0.10.@-Copt-level=1
