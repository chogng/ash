{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "@webgpu/types"]
  },
  "include": [
    "src/typings/**/*.d.ts",
    "src/ash/base/**/*.ts",
    "src/ash/code/browser/**/*.ts",
    "src/ash/code/electron-browser/workbench/**/*.ts",
    "src/ash/editor/*/browser/**/*.ts",
    "src/ash/editor/*/common/**/*.ts",
    "src/ash/editor/*/contrib/**/*.ts",
    "src/ash/editor/*/*.ts",
    "src/ash/platform/app-server/common/**/*.ts",
    "src/ash/platform/app-server/browser/**/*.ts",
    "src/ash/platform/action/common/**/*.ts",
    "src/ash/platform/actions/**/*.ts",
    "src/ash/platform/commands/common/**/*.ts",
    "src/ash/platform/configuration/common/**/*.ts",
    "src/ash/platform/contextkey/common/**/*.ts",
    "src/ash/platform/contextview/browser/**/*.ts",
    "src/ash/platform/contextview/electron-browser/**/*.ts",
    "src/ash/platform/editor/**/*.ts",
    "src/ash/platform/instantiation/common/**/*.ts",
    "src/ash/platform/keybinding/**/*.ts",
    "src/ash/platform/keyboardLayout/**/*.ts",
    "src/ash/platform/list/**/*.ts",
    "src/ash/platform/menubar/common/**/*.ts",
    "src/ash/platform/markdown/browser/**/*.ts",
    "src/ash/platform/native/common/**/*.ts",
    "src/ash/platform/native/electron-browser/**/*.ts",
    "src/ash/platform/search/**/*.ts",
    "src/ash/platform/browser/common/**/*.ts",
    "src/ash/platform/theme/browser/**/*.ts",
    "src/ash/platform/theme/common/**/*.ts",
    "src/ash/platform/workspace/common/**/*.ts",
    "src/ash/platform/webview/browser/**/*.ts",
    "src/ash/workbench/**/*.ts"
  ],
  "exclude": [
    "src/ash/base/test/**/*.ts",
    "src/ash/base/parts/**/electron-main/**/*.ts",
    "src/ash/editor/*/test/**/*.ts",
    "src/ash/platform/keybinding/electron-main/**/*.ts"
  ]
}
