{
  "name": "Ash Desktop, Web and backend",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "VNC_PASSWORD": "vscode"
  },
  "overrideCommand": false,
  "privileged": true,
  "workspaceFolder": "/workspaces/ash",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ash,type=bind",
  "remoteUser": "node",
  "mounts": [
    "source=ash-${devcontainerId}-node-modules,target=/workspaces/ash/node_modules,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-app-ts-node-modules,target=/workspaces/ash/app-ts/node_modules,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-build-node-modules,target=/workspaces/ash/build/node_modules,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-build-output,target=/workspaces/ash/.build,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-python-env,target=/workspaces/ash/scripts/.venv,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-third-party-cache,target=/workspaces/ash/third_party/.cache,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-tool-cache,target=/home/node/.cache,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-cargo-registry,target=/home/node/.cargo/registry,type=volume,volume-nocopy",
    "source=ash-${devcontainerId}-cargo-git,target=/home/node/.cargo/git,type=volume,volume-nocopy"
  ],
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "forwardPorts": [5173, 6080],
  "portsAttributes": {
    "5173": { "label": "Ash Web UI" },
    "6080": { "label": "Ash Desktop (noVNC)", "onAutoForward": "silent" }
  }
}
