{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": false,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["*.ts", "desktop/**/*.ts", "docs/**/*.ts", "download/**/*.ts", "lib/**/*.ts", "vite/**/*.ts", "app/**/*.ts", "package/**/*.ts", "pnpm/**/*.ts", "resources/**/*.ts"],
  "exclude": ["vite/stanza/**/*.ts"]
}
