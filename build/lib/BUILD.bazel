package(default_visibility = ["//visibility:public"])

filegroup(
    name = "archive_sources",
    srcs = ["__init__.py", "archive.py", "//build:__init__.py"],
)

filegroup(
    name = "signing_sources",
    srcs = [
        "__init__.py",
        "signing.py",
        "//build:__init__.py",
        "//build/darwin:python_sources",
        "//build/win32:python_sources",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(["*.py"], exclude = ["test_*.py", "package_test_support.py"]) + [
        "//build:__init__.py",
        "//build/download:python_sources",
    ],
)

filegroup(
    name = "assembly_sources",
    srcs = [
        "package-layout.json",
        "package.py",
        "livekit.py",
        "//third_party/livekit:runtime-lock.json",
        "//third_party/livekit:LICENSE",
        "//third_party/livekit-rust-sdks:LICENSE",
        "//third_party/livekit-rust-sdks:NOTICE",
        "//third_party/livekit:NOTICE",
        "//third_party/livekit:pkg/sfu/NOTICE",
        "//build/download:python_sources",
    ],
)

exports_files(["package_test_support.py"])
