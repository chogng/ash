#!/bin/sh
set -eu

if [ -x scripts/.venv/bin/python ]; then
    exec scripts/.venv/bin/python -B scripts/format.py --check --staged
elif [ -x scripts/.venv/Scripts/python.exe ]; then
    exec scripts/.venv/Scripts/python.exe -B scripts/format.py --check --staged
fi

echo 'Initialize repository tools with just install-python before committing.' >&2
exit 1
