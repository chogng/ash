{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".build/desktop/main",
    "incremental": true,
    "tsBuildInfoFile": ".build/desktop/main.tsbuildinfo",
    "rootDir": ".",
    "types": ["node", "electron"]
  },
  "include": [
    "src/bootstrap.ts",
    "src/main.ts",
    "src/ash/base/common/**/*.ts",
    "src/ash/base/parts/contextmenu/common/**/*.ts",
    "src/ash/base/parts/contextmenu/electron-main/**/*.ts",
    "src/ash/code/common/**/*.ts",
    "src/ash/code/electron-main/**/*.ts",
    "src/ash/code/electron-utility/**/*.ts",
    "src/ash/platform/app-server/electron-main/**/*.ts",
    "src/ash/platform/auxiliaryWindow/electron-main/**/*.ts",
    "src/ash/platform/app-server-daemon/electron-main/**/*.ts",
    "src/ash/platform/app-server-daemon/node/**/*.ts",
    "src/ash/platform/browserView/common/**/*.ts",
    "src/ash/platform/browserView/electron-main/**/*.ts",
    "src/ash/platform/browserView/node/**/*.ts",
    "src/ash/platform/utilityProcess/electron-main/**/*.ts",
    "src/ash/platform/clipboard/electron-main/**/*.ts",
    "src/ash/platform/configuration/common/**/*.ts",
    "src/ash/platform/configuration/electron-main/**/*.ts",
    "src/ash/platform/contextkey/common/**/*.ts",
    "src/ash/platform/contextview/electron-main/**/*.ts",
    "src/ash/platform/files/electron-main/**/*.ts",
    "src/ash/platform/ipc/electron-main/**/*.ts",
    "src/ash/platform/keybinding/common/**/*.ts",
    "src/ash/platform/menubar/common/**/*.ts",
    "src/ash/platform/menubar/electron-main/**/*.ts",
    "src/ash/platform/native/common/**/*.ts",
    "src/ash/platform/native/electron-main/**/*.ts",
    "src/ash/platform/storage/node/**/*.ts",
    "src/ash/platform/theme/common/**/*.ts",
    "src/ash/platform/theme/electron-main/**/*.ts",
    "src/ash/platform/window/common/**/*.ts",
    "src/ash/platform/window/electron-main/**/*.ts",
    "src/ash/platform/windows/electron-main/**/*.ts",
    "src/ash/platform/workspace/common/**/*.ts",
    "src/ash/platform/workspaces/common/**/*.ts",
    "src/ash/platform/workspaces/electron-main/**/*.ts",
    "src/ash/platform/workspaces/node/**/*.ts"
  ]
}
