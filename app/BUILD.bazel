load("//app:defs.bzl", "app_rust_binary")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

app_rust_binary(
    name = "app",
    crate_name = "app",
    crate_root = "main.rs",
    package_name = "app",
    source_globs = ["*.rs"],
)

exports_files([
    "Cargo.toml",
])

filegroup(
    name = "app_sources",
    srcs = glob([
        "*.rs",
        "Cargo.toml",
    ]) + [
        "//:Cargo.lock",
        "//:Cargo.toml",
        "//app/commands:commands_sources",
        "//app/editor:editor_sources",
        "//app/editor-host:editor-host_sources",
        "//app/files:files_sources",
        "//app/icons:icons_sources",
        "//ash-rs/keybinding:keybinding_sources",
        "//app/markdown:markdown_sources",
        "//app/scm:scm_sources",
        "//app/keybindings:keybindings_sources",
        "//app/session:session_sources",
        "//app/settings:settings_sources",
        "//app/terminal-runtime:terminal-runtime_sources",
        "//app/theme:theme_sources",
        "//app/ui-components:ui-components_sources",
        "//app/workbench:workbench_sources",
        "//app/zui:zui_sources",
    ],
)

filegroup(
    name = "app_package_contract",
    srcs = [
        "packaging/app-package-contract.json",
        "packaging/app-signing-policy.json",
    ],
)

filegroup(
    name = "app_package_tool",
    srcs = [
        "//build/app:python_sources",
    ],
)

filegroup(
    name = "app_release_inputs",
    srcs = [
        ":app_package_contract",
        ":app_package_tool",
        ":app_sources",
    ],
)

py_test(
    name = "app_boundary_test",
    srcs = ["//build/app:check_boundary.py"],
    main = "//build/app:check_boundary.py",
    args = [
        "$(location //:Cargo.toml)",
        "$(location Cargo.toml)",
        "$(location //:Cargo.lock)",
    ],
    data = [
        ":app_sources",
        "//:Cargo.lock",
        "//:Cargo.toml",
        "Cargo.toml",
        "//build/app:check_boundary.py",
    ],
    size = "small",
)

py_test(
    name = "app_package_test",
    srcs = [
        "//build/app:python_sources",
        "//build/app:test_package.py",
        "//build/remote:test_bundle.py",
    ],
    main = "//build/app:test_package.py",
    data = [
        "//app:app_package_contract",
        "Cargo.toml",
    ],
    size = "small",
)

py_test(
    name = "remote_runtime_bundle_test",
    srcs = [
        "//build/remote:python_sources",
        "//build/remote:test_bundle.py",
    ],
    main = "//build/remote:test_bundle.py",
    size = "small",
)

py_test(
    name = "app_release_contract_test",
    srcs = ["//build/app:check_contract.py"],
    main = "//build/app:check_contract.py",
    args = [
        "$(location packaging/app-package-contract.json)",
        "$(location packaging/app-signing-policy.json)",
    ],
    data = [
        "packaging/app-package-contract.json",
        "packaging/app-signing-policy.json",
        "//build/app:check_contract.py",
    ],
    size = "small",
)

py_test(
    name = "app_signing_test",
    srcs = [
        "//build/app:python_sources",
        "//build/app:test_signing.py",
        "//build/remote:test_bundle.py",
    ],
    main = "//build/app:test_signing.py",
    data = [
        "//app:app_package_contract",
        "Cargo.toml",
    ],
    size = "small",
)

test_suite(
    name = "app_ci",
    tests = [
        ":remote_runtime_bundle_test",
        ":app_boundary_test",
        ":app_package_test",
        ":app_release_contract_test",
        ":app_signing_test",
    ],
)
