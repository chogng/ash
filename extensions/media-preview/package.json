{
  "name": "media-preview",
  "ashUiTargets": [
    "ide",
    "agents"
  ],
  "publisher": "ash",
  "version": "1.0.0",
  "displayName": "%displayName%",
  "engines": {
    "ash": "*"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "ash.audioPreview",
        "displayName": "%audio.preview%",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.mp3",
            "mimeType": "audio/mpeg"
          },
          {
            "filenamePattern": "*.wav",
            "mimeType": "audio/wav"
          },
          {
            "filenamePattern": "*.ogg",
            "mimeType": "audio/ogg"
          },
          {
            "filenamePattern": "*.oga",
            "mimeType": "audio/ogg"
          }
        ]
      },
      {
        "viewType": "ash.videoPreview",
        "displayName": "%video.preview%",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.mp4",
            "mimeType": "video/mp4"
          },
          {
            "filenamePattern": "*.webm",
            "mimeType": "video/webm"
          }
        ]
      }
    ]
  }
}
