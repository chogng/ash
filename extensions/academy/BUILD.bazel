load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    data = glob(["browser/**/*.ts", "browser/**/*.css", "common/**/*.ts"]),
    deps = ["//crates/utils/editor-client-build"],
    edition = "2024",
)

ash_rust_crate(
    name = "academy",
    crate_name = "ash_academy",
    data = ["package.nls.json", "package.nls.zh-CN.json"],
    extra_deps = [":build_script"],
)

ash_rust_binary(
    name = "ash-academy",
    crate_name = "ash_academy",
    crate_root = "src/main.rs",
    deps = [":academy"],
)
