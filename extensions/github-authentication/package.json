{
  "name": "github-authentication",
  "ashUiTargets": [
    "ide",
    "agents"
  ],
  "publisher": "ash",
  "version": "1.0.0",
  "displayName": "GitHub Authentication",
  "description": "Profile-scoped GitHub authentication for Ash App.",
  "engines": {
    "ash": "*"
  },
  "ashRuntime": {
    "kind": "rust",
    "entrypoint": "ash-github-authentication",
    "scope": "profile",
    "capabilities": [
      "authentication.github"
    ],
    "clients": [
      "app"
    ]
  },
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "github.gitAuthentication": {
          "type": "boolean",
          "default": true,
          "title": "%gitAuthentication.title%",
          "description": "%gitAuthentication.description%"
        }
      }
    }
  }
}
