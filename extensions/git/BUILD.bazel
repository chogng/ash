load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")

ash_rust_crate(
    name = "git",
    crate_name = "git_extension",
    test_env = {"RUST_MIN_STACK": "8388608"},
    test_env_inherit = ["HOME", "PATH"] + select({
        "@platforms//os:windows": [
            "USERPROFILE",
            "LOCALAPPDATA",
            "ProgramFiles",
            "ProgramFiles(x86)",
            "ProgramW6432",
            "SystemRoot",
        ],
        "//conditions:default": [],
    }),
)

ash_rust_binary(
    name = "ash-git-extension",
    crate_name = "git_extension",
    crate_root = "src/main.rs",
    deps = [":git"],
)
