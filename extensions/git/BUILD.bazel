load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")

exports_files(glob(["src/*.rs"]) + ["package.json", "package.nls.json", "package.nls.zh-CN.json"], visibility = ["//crates/app-server:__pkg__"])

ash_rust_crate(
    name = "git-extension",
    crate_name = "git_extension",
    data = ["package.json", "package.nls.json", "package.nls.zh-CN.json"],
)

ash_rust_binary(
    name = "ash-git-extension",
    crate_name = "git_extension",
    crate_root = "src/main.rs",
    deps = [":git-extension"],
)
