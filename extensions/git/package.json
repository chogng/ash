    "configuration": {
      "title": "Git",
      "properties": {
        "git.autofetch": {
          "type": [
            "boolean",
            "string"
          ],
          "enum": [
            false,
            true,
            "all"
          ],
          "default": false,
          "scope": "application",
          "ashSetting": {
            "valueType": "select",
            "title": "%git.autofetch.title%",
            "description": "%git.autofetch.description%",
            "options": [
              {
                "value": false,
                "label": "%git.autofetch.off%"
              },
              {
                "value": true,
                "label": "%git.autofetch.default%"
              },
              {
                "value": "all",
                "label": "%git.autofetch.all%"
              }
            ]
          },
          "ashBinding": {
            "readCommand": "git.readSettings",
            "writeCommand": "git.updateAutoFetch",
            "property": "autoFetch"
          }
        },
        "git.autofetchPeriod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 180,
          "scope": "application",
          "ashSetting": {
            "valueType": "number",
            "title": "%git.autofetchPeriod.title%",
            "description": "%git.autofetchPeriod.description%",
            "minimum": 1,
            "maximum": 86400
          },
          "ashBinding": {
            "readCommand": "git.readSettings",
            "writeCommand": "git.updateAutoFetchPeriod",
            "property": "autoFetchPeriod"
          }
        }
      }
    },
