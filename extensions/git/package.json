        },
        {
          "submenu": "git.pullPushMenu",
          "when": "scmProvider == git",
          "group": "2_git"
        },
        {
          "submenu": "git.remoteMenu",
          "when": "scmProvider == git",
          "group": "2_git"
        },
        {
          "submenu": "git.stashMenu",
          "when": "scmProvider == git",
