{
  "name": "git",
  "publisher": "ash",
  "version": "0.1.0",
  "displayName": "%displayName%",
  "description": "%description%",
  "engines": {
    "vscode": "*"
  },
  "browser": "./browser/extension.ts",
  "ashFrontend": {
    "capabilities": {
      "git.repository": {
        "methods": {
          "initialize": {
            "route": "git/init"
          },
          "catalog": {
            "route": "git/catalog"
          },
          "executeCommand": {
            "route": "git/command"
          },
          "indexDiff": {
            "route": "git/indexDiff"
          },
          "editIndex": {
            "route": "git/indexEdit"
          },
          "clone": {
            "route": "git/clone"
          },
          "readConfig": {
            "route": "config/read",
            "resultFields": [
              "revision",
              "git",
              "gitConfigured"
            ]
          },
          "updateConfig": {
            "route": "config/update",
            "fields": [
              "commandId",
              "expectedRevision",
              "git"
            ],
            "resultFields": [
              "revision"
            ]
          },
          "repositories": {
            "route": "git/repositories"
          },
          "status": {
            "route": "git/status"
          },
          "history": {
            "route": "git/history"
          },
          "branches": {
            "route": "git/branch/list"
          },
          "createBranch": {
            "route": "git/branch/create"
          },
          "deleteBranch": {
            "route": "git/branch/delete"
          },
          "switchBranch": {
            "route": "git/branch/switch"
          },
          "worktrees": {
            "route": "git/worktree/list"
          },
          "createWorktree": {
            "route": "git/worktree/create"
          },
          "deleteWorktree": {
            "route": "git/worktree/delete"
          },
          "resolveWorktree": {
            "route": "git/worktree/resolve"
          },
          "graph": {
            "route": "git/graph"
          },
          "compareChanges": {
            "route": "git/compareChanges"
          },
          "commitMessage": {
            "route": "git/commitMessage"
          },
          "commitDetails": {
            "route": "git/commitDetails"
          },
          "commitChanges": {
            "route": "git/commitChanges"
          },
          "commitFile": {
            "route": "git/commitFile"
          },
          "changeFile": {
            "route": "git/changeFile"
          },
          "conflictFile": {
            "route": "git/conflictFile"
          },
          "completeConflict": {
            "route": "git/completeConflict"
          },
          "stage": {
            "route": "git/stage"
          },
          "unstage": {
            "route": "git/unstage"
          },
          "discardWorktree": {
            "route": "git/discardWorktree"
          },
          "commit": {
            "route": "git/commit"
          },
          "fetch": {
            "route": "git/fetch"
          },
          "pull": {
            "route": "git/pull"
          },
          "push": {
            "route": "git/push"
          },
          "checkIgnore": {
            "route": "git/checkIgnore"
          },
          "cancelIgnore": {
            "route": "git/checkIgnore/cancel"
          },
          "historyRefs": {
            "route": "git/history/refs",
            "fields": [
              "repositoryId"
            ]
          }
        },
        "notifications": [
          "git/statusChanged",
          "git/repositoriesChanged",
          "git/ignoreChanged",
          "config/changed"
        ]
      }
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ash.git.pull",
        "title": "%git.menu.pull%"
      },
      {
        "command": "ash.git.push",
