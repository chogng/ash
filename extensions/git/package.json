      "editor/title": [
        {
          "command": "git.openFile",
          "group": "navigation@10",
          "when": "resourceScheme == git-change"
        }
      ],
      "diffEditor/hunkToolbar": [
        {
          "command": "git.diff.stageHunk",
          "group": "primary",
          "when": "diffEditorOriginalUri =~ /^git-change:\\/unstaged\\// && diffEditorModifiedUri =~ /^git-change:\\/unstaged\\//"
        },
        {
          "command": "git.diff.unstageHunk",
          "group": "primary",
          "when": "diffEditorOriginalUri =~ /^git-change:\\/staged\\// && diffEditorModifiedUri =~ /^git-change:\\/staged\\//"
        },
        {
          "command": "git.diff.revertHunk",
          "group": "primary",
          "when": "diffEditorOriginalUri =~ /^git-change:\\/unstaged\\// && diffEditorModifiedUri =~ /^git-change:\\/unstaged\\//"
        }
      ],
      "diffEditor/selectionToolbar": [
