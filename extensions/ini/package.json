{
  "name": "ini",
  "ashUiTargets": [
    "ide"
  ],
  "publisher": "vscode",
  "version": "10.0.0",
  "displayName": "%displayName%",
  "description": "%description%",
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "ini",
        "extensions": [
          ".ini"
        ],
        "aliases": [
          "Ini",
          "ini"
        ],
        "configuration": "./ini.language-configuration.json"
      },
      {
        "id": "properties",
        "extensions": [
          ".conf",
          ".properties",
          ".cfg",
          ".directory",
          ".gitattributes",
          ".gitconfig",
          ".gitmodules",
          ".editorconfig",
          ".repo"
        ],
        "filenames": [
          "gitconfig"
        ],
        "filenamePatterns": [
          "**/.config/git/config",
          "**/.git/config"
        ],
        "aliases": [
          "Properties",
          "properties"
        ],
        "configuration": "./properties.language-configuration.json"
      }
    ]
  }
}
