{
  "name": "snapshot",
  "publisher": "ash",
  "version": "0.1.0",
  "type": "module",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/icon.png",
  "engines": {
    "ash": "*"
  },
  "browser": "./extension.ts",
  "l10n": "l10n",
  "activationEvents": [
    "onCapability:image.editor.v1",
    "onCommand:snapshot.code"
  ],
  "contributes": {
    "imageEditors": [
      {
        "id": "snapshot.editor",
        "displayName": "%displayName%",
        "default": true,
        "accessibilityHelp": "%capture.help%"
      }
    ],
    "commands": [
      {
        "command": "snapshot.code",
        "title": "%code.command%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snapshot.code",
          "when": "editorHasSelection",
          "group": "z_chat@2"
        }
      ]
    },
    "configuration": {
      "title": "Snapshot",
      "properties": {
        "screenshot.globalShortcut": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "title": "%global.title%",
          "description": "%global.description%"
        },
        "accessibility.verbosity.chatScreenshot": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "title": "%accessibility.title%",
          "description": "%accessibility.description%"
        },
        "snapshot.code.padding": {
          "type": "number",
          "default": 32,
          "minimum": 0,
          "maximum": 128,
          "scope": "application",
          "description": "%code.padding%"
        },
        "snapshot.code.scale": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "scope": "application",
          "description": "%code.scale%"
        },
        "snapshot.code.background": {
          "type": "string",
          "default": "#6366f1",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "application",
          "description": "%code.background%"
        },
        "snapshot.code.lineNumbers": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%code.lineNumbers%"
        },
        "snapshot.code.realLineNumbers": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%code.realLineNumbers%"
        },
        "snapshot.code.windowControls": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%code.windowControls%"
        },
        "snapshot.code.windowTitle": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%code.windowTitle%"
        },
        "snapshot.code.transparent": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%code.transparent%"
        }
      }
    }
  }
}
