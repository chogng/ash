{
  "name": "academic",
  "publisher": "ash",
  "version": "1.0.0",
  "displayName": "%academic.displayName%",
  "description": "%academic.description%",
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "stanza.editor.document",
        "displayName": "%academic.editor%",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.ash-academic",
            "mimeType": "application/vnd.ash.academic-document+json"
          },
          {
            "filenamePattern": "*.ash-paper"
          }
        ]
      },
      {
        "viewType": "ash.editor.document",
        "displayName": "%academic.generalEditor%",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.ash-doc",
            "mimeType": "application/vnd.ash.document+json"
          }
        ]
      },
      {
        "viewType": "ash.collaboration.notes",
        "displayName": "%academic.channelNotes%",
        "priority": "default",
        "selector": [
          {
            "mimeType": "application/vnd.ash.channel-notes+json"
          }
        ]
      }
    ]
  },
  "private": true,
  "ashRuntime": {
    "kind": "rust",
    "entrypoint": "ash-academy"
  },
  "activationEvents": [
    "*"
  ],
  "type": "module"
}
