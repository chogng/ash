load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")

exports_files(glob(["src/*.rs"]) + ["package.json", "package.nls.json", "package.nls.zh-CN.json", "runtime.json"], visibility = ["//crates/app-server:__pkg__"])

filegroup(
    name = "artifacts",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

ash_rust_crate(name = "debug-lldb", crate_name = "ash_debug_lldb", data = ["runtime.json", "package.nls.json", "package.nls.zh-CN.json"])

ash_rust_binary(
    name = "ash-debug-lldb",
    crate_name = "ash_debug_lldb",
    crate_root = "src/main.rs",
    deps = [":debug-lldb"],
)
