{
  "name": "css",
  "ashLanguageServers": {
    "version": 2,
    "servers": [
      {
        "id": "css-language-server",
        "languages": [
          "css",
          "less",
          "scss"
        ],
        "runtime": "node",
        "entrypoint": "server.cjs",
        "initializationOptions": {
          "provideFormatter": true
        },
        "settings": {
          "css": {},
          "less": {},
          "scss": {}
        }
      }
    ]
  },
  "dependencies": {
    "vscode-langservers-extracted": "4.10.0"
  },
  "ashUiTargets": [
    "ide"
  ],
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "icon": "media/icon.svg",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "ash": "*"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "css",
        "aliases": [
          "CSS",
          "css"
        ],
        "extensions": [
          ".css"
        ],
        "mimetypes": [
          "text/css"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "less",
        "aliases": [
          "Less",
          "less"
        ],
        "extensions": [
          ".less"
        ],
        "configuration": "./less-language-configuration.json"
      },
      {
        "id": "scss",
        "aliases": [
          "SCSS",
          "scss"
        ],
        "extensions": [
          ".scss"
        ],
        "configuration": "./scss-language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "less",
        "path": "./snippets/css.json"
      },
      {
        "language": "scss",
        "path": "./snippets/css.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
