      "foreground": "#b5cea8"
    },
    "enumMember": {
      "foreground": "#b5cea8"
    },
    "error": {
      "foreground": "#f44747"
    },
    "field": {
      "foreground": "#9cdcfe"
    },
    "float": {
      "foreground": "#b5cea8"
    },
    "include": {
      "foreground": "#569cd6"
