{
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "attribute": {
      "foreground": "#e50000"
    },
    "boolean": {
      "foreground": "#0000ff"
    },
    "character": {
      "foreground": "#a31515"
    },
    "comment": {
      "foreground": "#008000"
    },
    "conditional": {
      "foreground": "#0000ff"
    },
    "constant.builtin": {
      "foreground": "#0000ff"
    },
    "constant.character.escape.ignore": {
      "foreground": "#098658"
    },
    "enumMember": {
      "foreground": "#098658"
    },
    "error": {
      "foreground": "#cd3131"
    },
    "field": {
      "foreground": "#e50000"
    },
    "float": {
      "foreground": "#098658"
    },
    "include": {
      "foreground": "#0000ff"
    },
    "keyword": {
      "foreground": "#0000ff"
    },
    "macro": {
      "foreground": "#0000ff"
    },
    "markup.heading": {
      "foreground": "#800000",
      "fontStyle": "bold"
    },
    "markup.link": {
      "foreground": "#a31515",
      "fontStyle": "underline"
    },
    "markup.raw": {
      "foreground": "#800000"
    },
    "markup.strikethrough": {
      "fontStyle": "strikethrough"
    },
    "modifier": {
      "foreground": "#0000ff"
    },
    "number": {
      "foreground": "#098658"
    },
    "operator": {
      "foreground": "#000000"
    },
    "operator.negation.ignore": {
      "foreground": "#0000ff"
    },
    "operator.wildcard.ignore": {
      "foreground": "#0000ff"
    },
    "punctuation.list": {
      "foreground": "#0451a5"
    },
    "punctuation.quote": {
      "foreground": "#0451a5"
    },
    "regexp": {
      "foreground": "#811f3f"
    },
    "repeat": {
      "foreground": "#0000ff"
    },
    "storageclass": {
      "foreground": "#0000ff"
    },
    "string": {
      "foreground": "#a31515"
    },
    "string.regexp": {
      "foreground": "#811f3f"
    },
    "tag": {
      "foreground": "#800000"
    },
    "text.emphasis": {
      "foreground": "#800080",
      "fontStyle": "italic"
    },
    "text.literal": {
      "foreground": "#800000"
    },
    "text.reference": {
      "fontStyle": "underline"
    },
    "text.strong": {
      "foreground": "#000080",
      "fontStyle": "bold"
    },
    "text.title": {
      "foreground": "#800000",
      "fontStyle": "bold"
    },
    "text.uri": {
      "foreground": "#a31515",
      "fontStyle": "underline"
    },
    "newOperator": "#0000ff",
    "stringLiteral": "#a31515",
    "customLiteral": "#000000",
    "numberLiteral": "#098658",
    "property": {
      "foreground": "#e50000"
    }
  }
}
