{
  "$schema": "vscode://schemas/color-theme",
  "name": "Ash Dark",
  "type": "dark",
  "include": "./dark_syntax.json",
  "colors": {
    "foreground": "#cccccc",
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "scrollbar.shadow": "#191b1d4d",
    "scrollbarSlider.background": "#a8a9aa85",
    "scrollbarSlider.hoverBackground": "#a8a9aa90",
    "scrollbarSlider.activeBackground": "#a8a9aa9c",
    "editor.token.commentForeground": "#6a9955",
    "editor.token.keywordForeground": "#c586c0",
    "editor.token.stringForeground": "#ce9178",
    "editor.token.numberForeground": "#b5cea8",
    "editor.token.typeForeground": "#4ec9b0",
    "editor.token.functionForeground": "#dcdcaa",
    "workbench.background": "#1e1e1e",
    "editor.tabBackground": "#252526",
    "titleBar.background": "#1e1e1e",
    "titleBar.foreground": "#cccccc",
    "titleBar.actionForeground": "#b8b8b8",
    "titleBar.hoverBackground": "#333333",
    "commandCenter.background": "#2b2b2b",
    "commandCenter.foreground": "#cccccc",
    "commandCenter.border": "#454545",
    "commandCenter.hoverBackground": "#333333",
    "commandCenter.activeBorder": "#888888",
    "sideBar.background": "#252526",
    "list.activeSelectionBackground": "#ffffff22",
    "list.activeSelectionForeground": "#ededed",
    "list.inactiveSelectionBackground": "#2c2d2e",
    "list.hoverBackground": "#ffffff14",
    "activityBar.background": "#252526",
    "auxiliaryBar.background": "#252526",
    "panel.background": "#252526",
    "modernActivityBarItem.activeBackground": "#373737",
    "modernActivityBarItem.hoverBackground": "#333333",
    "modernActivityBarItem.activeForeground": "#cccccc",
    "compositeBar.foreground": "#ffffff",
    "compositeBar.inactiveForeground": "#858585",
    "statusBar.background": "#1e1e1e",
    "statusBar.foreground": "#cccccc"
  }
}
