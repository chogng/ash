{
  "name": "powershell",
  "ashUiTargets": [
    "ide"
  ],
  "publisher": "ash",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": "%displayName%",
  "description": "%description%",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "powershell",
        "aliases": [
          "PowerShell",
          "powershell",
          "ps",
          "ps1",
          "pwsh"
        ],
        "extensions": [
          ".ps1",
          ".psm1",
          ".psd1",
          ".pssc",
          ".psrc"
        ],
        "firstLine": "^#!\\s*/.*\\bpwsh\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "powershell",
        "path": "./snippets/code.code-snippets"
      }
    ]
  }
}
