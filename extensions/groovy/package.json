{
  "name": "groovy",
  "ashUiTargets": [
    "ide"
  ],
  "publisher": "ash",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": "%displayName%",
  "description": "%description%",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "groovy",
        "aliases": [
          "Groovy",
          "groovy"
        ],
        "extensions": [
          ".groovy",
          ".gvy",
          ".gradle",
          ".jenkinsfile",
          ".nf"
        ],
        "filenames": [
          "Jenkinsfile"
        ],
        "filenamePatterns": [
          "Jenkinsfile*"
        ],
        "firstLine": "^#!.*\\bgroovy\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "groovy",
        "path": "./snippets/code.code-snippets"
      }
    ]
  }
}
