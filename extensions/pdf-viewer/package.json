{
  "name": "pdf-viewer",
  "publisher": "ash",
  "version": "1.0.0",
  "displayName": "%pdfViewer.displayName%",
  "description": "%pdfViewer.description%",
  "engines": {
    "ash": "*"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "ash.workbench.pdfViewer",
        "displayName": "%pdfViewer.editor%",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.pdf",
            "mimeType": "application/pdf"
          }
        ]
      }
    ]
  },
  "private": true,
  "ashRuntime": {
    "kind": "rust",
    "entrypoint": "ash-pdf-viewer",
    "client": {
      "apiVersion": 1,
      "entry": "dist/editor.js",
      "style": "dist/editor.css"
    }
  },
  "activationEvents": [
    "onDemand:dataChannel"
  ],
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.0.3",
    "pdfjs-dist": "6.1.200"
  },
  "devDependencies": {
    "esbuild": "0.27.3"
  }
}
