filegroup(
    name = "artifacts",
    srcs = glob(["**"]) + ["//extensions/remote-ssh:artifacts", "//extensions/debug-lldb:artifacts"],
    visibility = ["//visibility:public"],
)

# Shared compile-time queries for the Rust syntax engine; browser builds import the same files.
filegroup(
    name = "tree-sitter-queries",
    srcs = glob(["*/queries/*.scm"]),
    visibility = ["//crates/syntax:__pkg__"],
)

# Contract tests consume the same declaration that ships in the Rust extension.
exports_files(
    ["rust/package.json"],
    visibility = ["//crates/app-server:__pkg__", "//crates/lsp-server-provider:__pkg__"],
)
