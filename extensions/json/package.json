{
  "name": "json",
  "ashUiTargets": [
    "ide",
    "agents"
  ],
  "publisher": "ash",
  "version": "0.1.0",
  "displayName": "JSON",
  "contributes": {
    "languages": [
      {
        "id": "json",
        "aliases": [
          "JSON",
          "json"
        ],
        "extensions": [
          ".json"
        ],
        "filenames": [
          "composer.lock",
          ".watchmanconfig"
        ],
        "mimetypes": [
          "application/json",
          "application/manifest+json"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jsonc",
        "aliases": [
          "JSON with Comments"
        ],
        "extensions": [
          ".jsonc",
          ".ash-workspace",
          ".code-workspace",
          ".eslintrc",
          ".eslintrc.json",
          ".jsfmtrc",
          ".jshintrc",
          ".swcrc",
          ".hintrc",
          ".babelrc"
        ],
        "filenames": [
          "settings.json",
          "keybindings.json",
          "tasks.json",
          "launch.json",
          "extensions.json",
          "argv.json",
          "babel.config.json",
          "bun.lock",
          ".babelrc.json",
          ".ember-cli",
          "typedoc.json"
        ],
        "filenamePatterns": [
          "**/.github/hooks/*.json"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jsonl",
        "aliases": [
          "%jsonl.alias%",
          "jsonl"
        ],
        "extensions": [
          ".jsonl",
          ".ndjson"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "snippets",
        "aliases": [
          "%snippets.alias%",
          "snippets"
        ],
        "extensions": [
          ".code-snippets"
        ],
        "filenamePatterns": [
          "**/User/snippets/*.json",
          "**/User/profiles/*/snippets/*.json",
          "**/snippets*.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "jsonl",
        "path": "./snippets/jsonl.code-snippets"
      },
      {
        "language": "snippets",
        "path": "./snippets/snippets.code-snippets"
      }
    ]
  }
}
