{
  "name": "dev-containers",
  "ashUiTargets": [
    "agents"
  ],
  "publisher": "ash",
  "version": "1.0.0",
  "displayName": "%displayName%",
  "description": "%description%",
  "engines": {
    "ash": "*"
  },
  "ashRuntime": {
    "kind": "rust",
    "entrypoint": "ash-dev-container-provider",
    "scope": "profile",
    "capabilities": [
      "sessionRuntime.v1"
    ],
    "clients": [
      "app",
      "code"
    ]
  }
}
