{
  "name": "git-base",
  "ashUiTargets": [
    "ide"
  ],
  "publisher": "vscode",
  "version": "10.0.0",
  "displayName": "%displayName%",
  "description": "%description%",
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "git-commit",
        "aliases": [
          "Git Commit Message",
          "git-commit"
        ],
        "filenames": [
          "COMMIT_EDITMSG",
          "MERGE_MSG"
        ],
        "configuration": "./languages/git-commit.language-configuration.json"
      },
      {
        "id": "git-rebase",
        "aliases": [
          "Git Rebase Message",
          "git-rebase"
        ],
        "filenames": [
          "git-rebase-todo"
        ],
        "filenamePatterns": [
          "**/rebase-merge/done"
        ],
        "configuration": "./languages/git-rebase.language-configuration.json"
      },
      {
        "id": "ignore",
        "aliases": [
          "Ignore",
          "ignore",
          "gitignore"
        ],
        "extensions": [
          ".gitignore_global",
          ".gitignore",
          ".git-blame-ignore-revs"
        ],
        "configuration": "./languages/ignore.language-configuration.json",
        "filenamePatterns": [
          "**/.git/info/exclude",
          "**/.config/git/ignore"
        ]
      }
    ]
  }
}
