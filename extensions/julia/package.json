{
  "name": "julia",
  "ashUiTargets": [
    "ide"
  ],
  "publisher": "ash",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": "%displayName%",
  "description": "%description%",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "julia",
        "aliases": [
          "Julia",
          "julia"
        ],
        "extensions": [
          ".jl"
        ],
        "firstLine": "^#!\\s*/.*\\bjulia[0-9.-]*\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "julia",
        "path": "./snippets/code.code-snippets"
      }
    ]
  }
}
