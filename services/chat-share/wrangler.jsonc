{
  "name": "ash-chat-share",
  "main": "worker.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "ash-chat-shares" }],
  "ratelimits": [
    {
      "name": "PUBLISH_LIMIT",
      "namespace_id": "20261109",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
