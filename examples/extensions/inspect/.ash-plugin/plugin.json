{
  "schemaVersion": 1,
  "id": "ash/inspect-example",
  "version": "0.1.0",
  "displayName": "Ash VS Code API example",
  "description": "Read a document and provide a plaintext hover through the standard VS Code API.",
  "license": "Apache-2.0",
  "compatibility": {
    "ash": ">=0.1.0"
  },
  "contributions": {
    "editorExtensions": [
      {
        "id": "inspect",
        "runtime": "javascript",
        "entrypoint": "extension.cjs",
        "runtimeApiVersion": 1,
        "activationEvents": [
          {
            "type": "onCommand",
            "id": "ash.example.inspect"
          },
          {
            "type": "onLanguage",
            "id": "plaintext"
          }
        ],
        "capabilities": ["command", "languageProvider"],
        "api": "vscode"
      }
    ]
  },
  "permissions": [
    {
      "type": "directory",
      "access": "read"
    }
  ]
}
