{
  "schemaVersion": 1,
  "id": "ash/inspect-example",
  "version": "0.1.0",
  "displayName": "Ash TypeScript SDK example",
  "description": "Read an authorized workspace file through the Rust filesystem service.",
  "license": "Apache-2.0",
  "compatibility": {
    "ash": ">=0.1.0"
  },
  "contributions": {
    "editorExtensions": [
      {
        "id": "inspect",
        "runtime": "javascript",
        "entrypoint": "dist/extension.js",
        "runtimeApiVersion": 1,
        "activationEvents": [
          {
            "type": "onCommand",
            "id": "ash.example.inspect"
          }
        ],
        "capabilities": ["command"],
        "api": "ash"
      }
    ]
  },
  "permissions": [
    {
      "type": "directory",
      "access": "read"
    }
  ]
}
