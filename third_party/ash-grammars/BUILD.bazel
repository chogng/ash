package(default_visibility = ["//visibility:public"])

exports_files([
    "runtime-lock.json",
    "targets.BUILD.bazel",
    "repositories.bzl",
])

[
    config_setting(
        name = "linux_%s_musl" % arch,
        constraint_values = [
            "@platforms//cpu:" + arch,
            "@platforms//os:linux",
            "@llvm//constraints/libc:musl",
        ],
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
]

alias(
    name = "library",
    actual = select({
        "@rules_rs//rs/platforms/config:aarch64-apple-darwin": "@ash_grammars_aarch64_apple_darwin//:library",
        "@rules_rs//rs/platforms/config:aarch64-pc-windows-msvc": "@ash_grammars_aarch64_pc_windows_msvc//:library",
        "@rules_rs//rs/platforms/config:aarch64-unknown-linux-gnu": "@ash_grammars_aarch64_unknown_linux_gnu//:library",
        ":linux_aarch64_musl": "@ash_grammars_aarch64_unknown_linux_musl//:library",
        "@rules_rs//rs/platforms/config:x86_64-apple-darwin": "@ash_grammars_x86_64_apple_darwin//:library",
        "@rules_rs//rs/platforms/config:x86_64-pc-windows-msvc": "@ash_grammars_x86_64_pc_windows_msvc//:library",
        "@rules_rs//rs/platforms/config:x86_64-unknown-linux-gnu": "@ash_grammars_x86_64_unknown_linux_gnu//:library",
        ":linux_x86_64_musl": "@ash_grammars_x86_64_unknown_linux_musl//:library",
    }),
)
