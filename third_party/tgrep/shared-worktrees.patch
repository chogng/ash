+fn repository() -> tempfile::TempDir {
+    let root = tempfile::tempdir().unwrap();
+    git(root.path(), &["init", "-b", "main"]).unwrap();
+    git(root.path(), &["config", "user.name", "Search Test"]).unwrap();
+    git(
+        root.path(),
+        &["config", "user.email", "search@example.test"],
+    )
+    .unwrap();
+    std::fs::write(root.path().join("source.rs"), "base_marker\n").unwrap();
+    std::fs::write(root.path().join("deleted.rs"), "delete_marker\n").unwrap();
+    std::fs::write(root.path().join("ignored.rs"), "ignore_marker\n").unwrap();
+    git(root.path(), &["add", "."]).unwrap();
+    git(root.path(), &["commit", "-m", "base"]).unwrap();
+    root
+}
+
+fn query(service: &Arc<Service>, id: u64, pattern: &str) -> Value {
+    dispatch(
+        &json!({"method":"search","params":{"worktree_id":id,"pattern":pattern,"stats":true}}),
+        service,
+    )
+    .unwrap()
+}
