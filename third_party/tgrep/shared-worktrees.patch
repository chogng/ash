+#[test]
+fn restored_overlay_reconciles_reverts_and_preserves_global_path_order() {
+    let root = repository();
+    let storage = tempfile::tempdir().unwrap();
+    let create = || {
+        Arc::new(
+            Service::new(
+                root.path(),
+                storage.path(),
+                walker::DEFAULT_MAX_FILE_SIZE,
+                true,
+            )
+            .unwrap(),
+        )
+    };
+    let service = create();
+    let a = service.attach(&json!({"root":root.path()})).unwrap()["worktree_id"]
+        .as_u64()
+        .unwrap();
+    std::fs::write(root.path().join("source.rs"), "edited_marker\n").unwrap();
+    dispatch(
+        &json!({"method":"refresh","params":{"worktree_id":a}}),
+        &service,
+    )
+    .unwrap();
+    drop(service);
+    std::fs::write(root.path().join("source.rs"), "base_marker\n").unwrap();
+    std::fs::write(root.path().join("a.rs"), "base_marker\n".repeat(4)).unwrap();
+    let service = create();
+    let a = service.attach(&json!({"root":root.path()})).unwrap()["worktree_id"]
+        .as_u64()
+        .unwrap();
+    assert!(
+        query(&service, a, "edited_marker")["matches"]
+            .as_array()
+            .unwrap()
+            .is_empty()
+    );
+    let result = dispatch(&json!({"method":"search","params":{"worktree_id":a,"pattern":"base_marker","max_results":3,"max_count":3,"stats":true,"glob":["*.rs"]}}), &service).unwrap();
+    assert_eq!(result["matches"].as_array().unwrap().len(), 3);
+    assert_eq!(result["matches"][2]["file"], "a.rs");
+    assert_eq!(result["matches"][2]["line"], 3);
+    assert_eq!(
+        service.views.read().unwrap()[&a]
+            .lock()
+            .unwrap()
+            .index
+            .live
+            .num_files(),
+        1
+    );
+}
