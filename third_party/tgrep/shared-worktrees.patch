+#[test]
+fn shared_views_isolate_commits_deletes_admission_and_registration_lifetimes() {
+    let root = repository();
+    let linked = tempfile::tempdir().unwrap();
+    let path = linked.path().join("linked");
+    git(
+        root.path(),
+        &["worktree", "add", "-b", "agent", path.to_str().unwrap()],
+    )
+    .unwrap();
+    let storage = tempfile::tempdir().unwrap();
+    let service = Arc::new(
+        Service::new(
+            root.path(),
+            storage.path(),
+            walker::DEFAULT_MAX_FILE_SIZE,
+            true,
+        )
+        .unwrap(),
+    );
+    let a = service.attach(&json!({"root":root.path()})).unwrap()["worktree_id"]
+        .as_u64()
+        .unwrap();
+    let b = service.attach(&json!({"root":path})).unwrap()["worktree_id"]
+        .as_u64()
+        .unwrap();
+    {
+        let views = service.views.read().unwrap();
+        let a = views[&a].lock().unwrap();
+        let b = views[&b].lock().unwrap();
+        assert!(Arc::ptr_eq(&a.index.reader_arc(), &b.index.reader_arc()));
+        assert_eq!(a.index.live.num_files(), 0);
+        assert_eq!(b.index.live.num_files(), 0);
+    }
+    std::fs::write(path.join("source.rs"), "branch_marker\n").unwrap();
+    std::fs::remove_file(path.join("deleted.rs")).unwrap();
+    std::fs::write(path.join(".gitignore"), "ignored.rs\n").unwrap();
+    std::fs::write(path.join("new.rs"), "new_marker\n").unwrap();
+    git(&path, &["add", "."]).unwrap();
+    git(&path, &["commit", "-m", "branch differences"]).unwrap();
+    dispatch(
+        &json!({"method":"refresh","params":{"worktree_id":b}}),
+        &service,
+    )
+    .unwrap();
+    assert_eq!(
+        query(&service, a, "base_marker")["matches"]
+            .as_array()
+            .unwrap()
+            .len(),
+        1
+    );
+    assert!(
+        query(&service, b, "base_marker")["matches"]
+            .as_array()
+            .unwrap()
+            .is_empty()
+    );
+    assert_eq!(
+        query(&service, b, "branch_marker")["matches"]
+            .as_array()
+            .unwrap()
+            .len(),
+        1
+    );
+    assert!(
+        query(&service, b, "delete_marker|ignore_marker")["matches"]
+            .as_array()
+            .unwrap()
+            .is_empty()
+    );
+    assert_eq!(
+        query(&service, b, "new_marker")["matches"]
+            .as_array()
+            .unwrap()
+            .len(),
+        1
+    );
+    let files = dispatch(
+        &json!({"method":"files","params":{"worktree_id":b}}),
+        &service,
+    )
+    .unwrap();
+    assert!(
+        !files["files"]
+            .as_array()
+            .unwrap()
+            .contains(&json!("ignored.rs"))
+    );
+    let repeated = service.attach(&json!({"root":root.path()})).unwrap();
+    assert_eq!(repeated["worktree_id"], a);
+    dispatch(
+        &json!({"method":"detach","params":{"worktree_id":a}}),
+        &service,
+    )
+    .unwrap();
+    assert_eq!(query(&service, a, "base_marker")["num_matches"], 1);
+    dispatch(
+        &json!({"method":"detach","params":{"worktree_id":a}}),
+        &service,
+    )
+    .unwrap();
+    assert!(!service.views.read().unwrap().contains_key(&a));
+    assert_eq!(query(&service, b, "branch_marker")["num_matches"], 1);
+    drop(service);
+    // Restart restores a compatible checkpoint and reconciles against current
+    // HEAD; committed branch changes cannot vanish just because status is clean.
+    let restarted = Arc::new(
+        Service::new(
+            root.path(),
+            storage.path(),
+            walker::DEFAULT_MAX_FILE_SIZE,
+            true,
+        )
+        .unwrap(),
+    );
+    let c = restarted.attach(&json!({"root":path})).unwrap()["worktree_id"]
+        .as_u64()
+        .unwrap();
+    assert_eq!(query(&restarted, c, "branch_marker")["num_matches"], 1);
+    assert_eq!(
+        git(root.path(), &["worktree", "list", "--porcelain"])
+            .unwrap()
+            .matches("worktree ")
+            .count(),
+        2
+    );
+}
