+//! Repository-scoped serving. Every view pins immutable index bytes; all
+//! admission and final matching use the requesting worktree's filesystem.
+use super::{
+    DecodedFile, SearchScope, json_rpc_error, json_rpc_result, open_within_root,
+    parse_search_params, search_file_matches,
+};
+use anyhow::{Context, Result, bail, ensure};
+use notify::{RecommendedWatcher, RecursiveMode, Watcher};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::TcpListener;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, RwLock};
+use std::time::{Duration, Instant};
+use tgrep_core::{builder, hybrid::HybridIndex, live::LiveIndex, meta, shared::SharedBase, walker};
+
+const PROTOCOL: u32 = 1;
+const RECONCILE_INTERVAL: Duration = Duration::from_secs(120);
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+pub struct Identity {
+    pub directory: PathBuf,
+    pub repository: bool,
+}
+
+pub fn identity(root: &Path) -> Result<Identity> {
+    let root = std::fs::canonicalize(root)?;
+    // Plain directories remain usable without Git on PATH. Only repository
+    // discovery needs Git to resolve linked worktrees and common directories.
+    if std::env::var_os("GIT_DIR").is_none()
+        && !root.ancestors().any(|path| path.join(".git").exists())
+    {
+        return Ok(Identity {
+            directory: root,
+            repository: false,
+        });
+    }
+    let output = Command::new("git")
+        .env("LC_ALL", "C")
+        .arg("-C")
+        .arg(&root)
+        .args(["rev-parse", "--path-format=absolute", "--git-common-dir"])
+        .output()?;
+    if output.status.success() {
+        let directory = std::fs::canonicalize(std::str::from_utf8(&output.stdout)?.trim())?;
+        Ok(Identity {
+            directory,
+            repository: true,
+        })
+    } else {
+        // A plain directory is a supported corpus. Other Git failures cannot
+        // change a repository into a separate, unshared search identity.
+        ensure!(
+            String::from_utf8_lossy(&output.stderr).contains("not a git repository"),
+            "Git identity failed: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        Ok(Identity {
+            directory: root,
+            repository: false,
+        })
+    }
+}
+
+pub fn print_identity(root: &Path) -> Result<()> {
+    println!("{}", serde_json::to_string(&identity(root)?)?);
+    Ok(())
+}
+
+fn git(root: &Path, args: &[&str]) -> Result<String> {
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(args)
+        .output()?;
+    ensure!(
+        output.status.success(),
+        "Git command failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    Ok(std::str::from_utf8(&output.stdout)?.trim().to_owned())
+}
+
+struct Base {
+    shared: SharedBase,
+    evidence: meta::FileEvidence,
+    revision: Option<String>,
+    key: String,
+}
+
+// Git blobs are read without creating worktrees or running checkout hooks and
+// filters. A view compares decoded content identities, so CRLF, LFS and smudge
+// differences become ordinary private overrides rather than incorrect reuse.
+struct ObjectProcess(Child);
+impl Drop for ObjectProcess {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+fn materialize_tree(
+    repository: &Path,
+    revision: &str,
+    destination: &Path,
+    max_file_size: Option<u64>,
+) -> Result<()> {
+    let entries = Command::new("git")
+        .arg("-C")
+        .arg(repository)
+        .args(["ls-tree", "-r", "-z", revision])
+        .output()?;
+    ensure!(
+        entries.status.success(),
+        "could not enumerate the base tree"
+    );
+    let child = Command::new("git")
+        .arg("-C")
+        .arg(repository)
+        .args(["cat-file", "--batch"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .spawn()?;
+    let mut process = ObjectProcess(child);
+    let mut input = process.0.stdin.take().unwrap();
+    let mut output = BufReader::new(process.0.stdout.take().unwrap());
+    for entry in entries
+        .stdout
+        .split(|b| *b == 0)
+        .filter(|entry| !entry.is_empty())
+    {
+        let separator = entry
+            .iter()
+            .position(|b| *b == b'\t')
+            .context("invalid Git tree entry")?;
+        let (metadata, path) = (&entry[..separator], &entry[separator + 1..]);
+        let fields = std::str::from_utf8(metadata)?
+            .split_whitespace()
+            .collect::<Vec<_>>();
+        ensure!(fields.len() == 3, "invalid Git tree metadata");
+        if fields[0] != "100644" && fields[0] != "100755" {
+            continue;
+        }
+        let path = Path::new(std::str::from_utf8(path)?);
+        ensure!(
+            path.components()
+                .all(|part| matches!(part, std::path::Component::Normal(_))),
+            "invalid base path"
+        );
+        writeln!(input, "{}", fields[2])?;
+        input.flush()?;
+        let mut header = String::new();
+        output.read_line(&mut header)?;
+        let object = header.split_whitespace().collect::<Vec<_>>();
+        ensure!(
+            object.len() == 3 && object[0] == fields[2] && object[1] == "blob",
+            "invalid Git object reply"
+        );
+        let length = object[2].parse::<u64>()?;
+        let copied = if max_file_size.is_some_and(|limit| length > limit) {
+            std::io::copy(&mut (&mut output).take(length), &mut std::io::sink())?
+        } else {
+            let absolute = destination.join(path);
+            std::fs::create_dir_all(absolute.parent().unwrap())?;
+            let mut file = std::fs::File::create(absolute)?;
+            std::io::copy(&mut (&mut output).take(length), &mut file)?
+        };
+        ensure!(copied == length, "truncated Git object");
+        let mut newline = [0];
+        output.read_exact(&mut newline)?;
+        ensure!(newline == *b"\n", "invalid Git object delimiter");
+    }
+    drop(input);
+    ensure!(process.0.wait()?.success(), "Git object reader failed");
+    Ok(())
+}
+
+fn starting_revision(root: &Path) -> Result<Option<String>> {
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(["rev-parse", "--verify", "--quiet", "HEAD"])
+        .output()?;
+    if output.status.success() {
+        return Ok(Some(std::str::from_utf8(&output.stdout)?.trim().to_owned()));
+    }
+    ensure!(
+        output.status.code() == Some(1),
+        "could not resolve starting revision"
+    );
+    Ok(None)
+}
+
+struct View {
+    index: HybridIndex,
+    base: Arc<Base>,
+    contents: HashMap<String, meta::ContentId>,
+    versions: HashMap<String, meta::FileVersion>,
+    visibility: tgrep_core::visibility::PathVisibility,
+    filenames: Vec<String>,
+    dirty: Arc<AtomicBool>,
+    _watcher: RecommendedWatcher,
+    reconciled: Instant,
+    checkpoint: PathBuf,
+    registrations: usize,
+    ready: bool,
+}
+
+struct Service {
+    identity: Identity,
+    storage: PathBuf,
+    bases: Mutex<HashMap<String, Arc<Base>>>,
+    views: RwLock<BTreeMap<u64, Arc<Mutex<View>>>>,
+    attach_gate: Mutex<()>,
+    next_id: AtomicU64,
+    max_file_size: Option<u64>,
+    no_require_git: bool,
+}
+
+impl Service {
+    fn new(
+        root: &Path,
+        storage: &Path,
+        max_file_size: Option<u64>,
+        no_require_git: bool,
+    ) -> Result<Self> {
+        let identity = identity(root)?;
+        std::fs::create_dir_all(storage)?;
+        let storage = std::fs::canonicalize(storage)?;
+        ensure!(
+            !root.starts_with(&storage),
+            "storage must not contain the search root"
+        );
+        Ok(Self {
+            identity,
+            storage,
+            bases: Mutex::new(HashMap::new()),
+            views: RwLock::new(BTreeMap::new()),
+            attach_gate: Mutex::new(()),
+            next_id: AtomicU64::new(1),
+            max_file_size,
+            no_require_git,
+        })
+    }
+
+    fn base(&self, root: &Path) -> Result<Arc<Base>> {
+        let revision = if self.identity.repository {
+            starting_revision(root)?
+        } else {
+            None
+        };
+        let tree = match &revision {
+            Some(revision) => git(root, &["rev-parse", &format!("{revision}^{{tree}}")])?,
+            None => "empty".into(),
+        };
+        let key = format!(
+            "{tree}-{}-{}",
+            meta::INDEX_FORMAT_VERSION,
+            self.max_file_size
+                .map_or("unlimited".into(), |n| n.to_string())
+        );
+        let mut registered_bases = self.bases.lock().unwrap();
+        if let Some(base) = registered_bases.get(&key) {
+            return Ok(Arc::clone(base));
+        }
+        let bases = self.storage.join("bases");
+        std::fs::create_dir_all(&bases)?;
+        let destination = bases.join(&key);
+        if !destination.exists() {
+            let staging = tempfile::tempdir_in(&bases)?;
+            let source = tempfile::tempdir_in(&self.storage)?;
+            let source_root = source.path().join("tree");
+            std::fs::create_dir(&source_root)?;
+            if let Some(revision) = &revision {
+                materialize_tree(root, revision, &source_root, self.max_file_size)?;
+            }
+            // Ignore policy belongs to each view. The base retains a tracked
+            // superset so another branch can admit a path this one ignores.
+            builder::build_index_with_options(
+                &source_root,
+                Some(staging.path()),
+                &builder::BuildOptions {
+                    no_ignore: true,
+                    include_hidden: true,
+                    exclude_dirs: vec![".git".into()],
+                    exclude_paths: vec![source_root.join(".git")],
+                    max_file_size: self.max_file_size,
+                    ..Default::default()
+                },
+            )?;
+            let _ = SharedBase::open(staging.path())?;
+            std::fs::rename(staging.path(), &destination)?;
+        }
+        let base = Arc::new(Base {
+            shared: SharedBase::open(&destination)?,
+            evidence: meta::read_file_evidence(&destination)?,
+            revision,
+            key: key.clone(),
+        });
+        registered_bases.insert(key, Arc::clone(&base));
+        Ok(base)
+    }
+
+    fn attach(&self, params: &Value) -> Result<Value> {
+        let _attach = self.attach_gate.lock().unwrap();
+        let root = std::fs::canonicalize(required_path(params, "root")?)?;
+        ensure!(
+            identity(&root)? == self.identity,
+            "worktree belongs to another repository"
+        );
+        if let Some(expected) = params.get("expected_head").and_then(Value::as_str) {
+            ensure!(
+                self.identity.repository && git(&root, &["rev-parse", "HEAD"])? == expected,
+                "worktree HEAD changed before registration"
+            );
+        }
+        for (id, view) in self.views.read().unwrap().iter() {
+            let mut view = view.lock().unwrap();
+            if view.index.root == root {
+                view.refresh(self.max_file_size, self.no_require_git, &self.storage)?;
+                view.registrations += 1;
+                return Ok(
+                    json!({"worktree_id":id,"protocol":PROTOCOL,"base_revision":view.base.revision,"ready":true}),
+                );
+            }
+        }
+        let base = self.base(&root)?;
+        let dirty = Arc::new(AtomicBool::new(true));
+        let pending = Arc::clone(&dirty);
+        let excluded_storage = self.storage.clone();
+        let mut watcher =
+            notify::recommended_watcher(move |event: notify::Result<notify::Event>| {
+                // Checkpoint writes must not schedule another reconciliation
+                // when the configured cache lives inside the search root.
+                let changed = event.as_ref().map_or(true, |event| {
+                    super::event_changes_index(&event.kind)
+                        && (event.paths.is_empty()
+                            || event
+                                .paths
+                                .iter()
+                                .any(|path| !path.starts_with(&excluded_storage)))
+                });
+                if changed {
+                    pending.store(true, Ordering::SeqCst);
+                }
+            })?;
+        // Subscribe before traversal; notifications during the walk remain
+        // dirty and are reconciled before the following indexed query.
+        watcher.watch(&root, RecursiveMode::Recursive)?;
+        if self.identity.repository {
+            watcher.watch(&self.identity.directory, RecursiveMode::Recursive)?;
+        }
+        let overlays = self.storage.join("overlays");
+        std::fs::create_dir_all(&overlays)?;
+        // The file-table digest is only a stable filename; SharedBase also
+        // validates the canonical root and exact base bytes when restoring.
+        let name =
+            meta::ContentId::from_indexed_bytes(root.as_os_str().as_encoded_bytes()).to_hex();
+        let checkpoint = overlays.join(format!("{name}-{}.json", base.key));
+        let index = if checkpoint.exists() {
+            base.shared.restore_worktree(&root, &checkpoint)?
+        } else {
+            base.shared.create_worktree(&root)?
+        };
+        let mut view = View {
+            index,
+            base,
+            contents: HashMap::new(),
+            versions: HashMap::new(),
+            visibility: Default::default(),
+            filenames: Vec::new(),
+            dirty,
+            _watcher: watcher,
+            reconciled: Instant::now(),
+            checkpoint,
+            registrations: 1,
+            ready: false,
+        };
+        view.refresh(self.max_file_size, self.no_require_git, &self.storage)?;
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        let result = json!({"worktree_id":id,"protocol":PROTOCOL,"base_revision":view.base.revision,"ready":true});
+        self.views
+            .write()
+            .unwrap()
+            .insert(id, Arc::new(Mutex::new(view)));
+        Ok(result)
+    }
+}
+
+fn required_path<'a>(params: &'a Value, name: &str) -> Result<&'a Path> {
+    Ok(Path::new(
+        params
+            .get(name)
+            .and_then(Value::as_str)
+            .context("missing path")?,
+    ))
+}
+
+impl View {
+    fn refresh(
+        &mut self,
+        max_file_size: Option<u64>,
+        no_require_git: bool,
+        storage: &Path,
+    ) -> Result<()> {
+        self.ready = false;
+        self.dirty.store(false, Ordering::SeqCst);
+        let walk = walker::walk_dir(
+            &self.index.root,
+            &walker::WalkOptions {
+                include_hidden: true,
+                collect_gitignore_files: true,
+                no_require_git,
+                max_file_size,
+                exclude_dirs: vec![".git".into()],
+                exclude_paths: vec![storage.to_path_buf(), self.index.root.join(".git")],
+                ..Default::default()
+            },
+        );
+        ensure!(walk.skipped_error == 0, "worktree traversal was incomplete");
+        let mut present = HashSet::new();
+        for path in &walk.files {
+            let relative = relative_path(&self.index.root, path)?;
+            let mut file = open_within_root(&self.index.root, path)?;
+            let before = builder::file_version(&file.metadata()?);
+            if before.is_trusted()
+                && self.versions.get(&relative) == Some(&before)
+                && self.contents.contains_key(&relative)
+            {
+                present.insert(relative);
+                continue;
+            }
+            let bytes = match super::read_within_limit(
+                &mut file,
+                max_file_size,
+                before.stamp().size.min(1 << 20) as usize,
+            ) {
+                super::CappedRead::Data(bytes) => bytes,
+                super::CappedRead::TooLarge => continue,
+                super::CappedRead::Failed => bail!("could not read worktree file: {relative}"),
+            };
+            ensure!(
+                before == builder::file_version(&file.metadata()?)
+                    && super::file_still_has_bytes(&self.index.root, path, &before, &bytes)?,
+                "file changed during reconciliation: {relative}"
+            );
+            let text = tgrep_core::encoding::decode_for_index(&bytes);
+            if tgrep_core::trigram::is_binary(&text) {
+                continue;
+            }
+            let content_id = meta::ContentId::from_indexed_bytes(&text);
+            present.insert(relative.clone());
+            if self.base.evidence.content_id(&relative) == Some(content_id) {
+                self.index
+                    .live
+                    .clear_reconciled_paths(std::slice::from_ref(&relative));
+            } else if self.contents.get(&relative) != Some(&content_id)
+                || !self.index.live.has_path(&relative)
+            {
+                self.index
+                    .live
+                    .commit_upsert(&relative, LiveIndex::compute_trigram_masks(&text));
+            }
+            self.versions.insert(relative.clone(), before);
+            self.contents.insert(relative, content_id);
+        }
+        // Includes committed branch divergence and changes to corpus admission,
+        // rather than assuming a clean HEAD means the base is still correct.
+        let absent: Vec<_> = self
+            .index
+            .all_paths()
+            .into_iter()
+            .filter(|p| !present.contains(p))
+            .collect();
+        for path in absent {
+            self.index.live.delete_file(&path);
+        }
+        self.contents.retain(|p, _| present.contains(p));
+        self.versions.retain(|p, _| present.contains(p));
+        self.filenames = walk
+            .listed_files
+            .iter()
+            .map(|p| relative_path(&self.index.root, p))
+            .collect::<Result<_>>()?;
+        self.filenames.sort();
+        self.visibility = walk.visibility;
+        self.base
+            .shared
+            .save_overlay(&self.index, &self.checkpoint)?;
+        self.reconciled = Instant::now();
+        self.ready = true;
+        Ok(())
+    }
+
+    fn search(&self, params: &Value) -> Result<Value> {
+        let request = parse_search_params(params).map_err(anyhow::Error::msg)?;
+        let (ids, reader) = self.index.execute_query_with_masks(&request.plan);
+        let raw_candidates = ids.len();
+        let mut paths = ids
+            .into_iter()
+            .filter_map(|id| self.index.resolve_path(id, &reader))
+            .filter(|path| {
+                request.scope.relative(path).is_some_and(|scoped| {
+                    self.visibility
+                        .is_visible(path, &request.scope.prefix, request.scope.hidden)
+                        && request.type_filter.matches(scoped)
+                        && request.glob_filter.matches(scoped)
+                })
+            })
+            .collect::<Vec<_>>();
+        paths.sort();
+        let candidates = paths.len();
+        let limit = match params.get("max_results") {
+            Some(value) => {
+                let limit = value
+                    .as_u64()
+                    .context("max_results must be a positive integer")?;
+                ensure!((1..=5001).contains(&limit), "invalid max_results");
+                Some(limit as usize)
+            }
+            None => None,
+        };
+        let mut matches = Vec::new();
+        let mut file_stats = Vec::new();
+        for path in paths {
+            let mut file = match open_within_root(&self.index.root, &self.index.root.join(&path)) {
+                Ok(file) => file,
+                Err(error) if super::proves_ineligible(&error) => continue,
+                Err(error) => return Err(error.into()),
+            };
+            if request
+                .opts
+                .max_filesize
+                .is_some_and(|limit| file.metadata().is_ok_and(|m| m.len() > limit))
+            {
+                continue;
+            }
+            let mut bytes = Vec::new();
+            file.read_to_end(&mut bytes)?;
+            let content = DecodedFile::new(bytes, request.encoding);
+            let found = search_file_matches(&path, &content, &request.matcher, &request.opts)?;
+            matches.extend(found.rows);
+            file_stats.extend(found.stats);
+            if limit.is_some_and(|limit| matches.len() >= limit) {
+                matches.truncate(limit.unwrap());
+                break;
+            }
+        }
+        let mut result =
+            json!({"num_matches":matches.len(),"matches":matches,"hidden_complete":true});
+        if request.opts.stats {
+            result["file_stats"] = json!(file_stats);
+            result["index_stats"] = json!({"query_plan":crate::search::plan_summary(&request.plan),"raw_candidates":raw_candidates,"candidates":candidates,"total_files":self.index.num_files_using(&reader)});
+        }
+        Ok(result)
+    }
+}
+
+fn relative_path(root: &Path, path: &Path) -> Result<String> {
+    Ok(path
+        .strip_prefix(root)?
+        .to_str()
+        .context("worktree paths must be UTF-8")?
+        .replace(std::path::MAIN_SEPARATOR, "/"))
+}
+
+fn request(line: &str, service: &Arc<Service>) -> String {
+    let parsed: Value = match serde_json::from_str(line) {
+        Ok(value) => value,
+        Err(error) => return json_rpc_error(None, -32700, &error.to_string()),
+    };
+    let id = parsed.get("id").cloned();
+    let result = dispatch(&parsed, service);
+    match result {
+        Ok(value) => json_rpc_result(id, value),
+        Err(error) => json_rpc_error(id, -32000, &format!("{error:#}")),
+    }
+}
+
+fn dispatch(request: &Value, service: &Arc<Service>) -> Result<Value> {
+    let method = request
+        .get("method")
+        .and_then(Value::as_str)
+        .context("missing method")?;
+    let params = &request["params"];
+    match method {
+        "capabilities" => {
+            return Ok(json!({"shared_worktrees":PROTOCOL,"identity":service.identity}));
+        }
+        "attach" => return service.attach(params),
+        "detach" => {
+            let id = params["worktree_id"]
+                .as_u64()
+                .context("missing worktree_id")?;
+            let mut registered_views = service.views.write().unwrap();
+            let view = registered_views
+                .get(&id)
+                .context("unknown worktree")?
+                .clone();
+            let mut registration = view.lock().unwrap();
+            registration.registrations -= 1;
+            if registration.registrations == 0 {
+                registered_views.remove(&id);
+            }
+            drop(registration);
+            drop(view);
+            drop(registered_views);
+            service
+                .bases
+                .lock()
+                .unwrap()
+                .retain(|_, base| Arc::strong_count(base) > 1);
+            return Ok(Value::Null);
+        }
+        _ => {}
+    }
+    let id = params["worktree_id"]
+        .as_u64()
+        .context("missing worktree_id")?;
+    let view = Arc::clone(
+        service
+            .views
+            .read()
+            .unwrap()
+            .get(&id)
+            .context("unknown worktree")?,
+    );
+    let (max_file_size, no_require_git, storage) = (
+        service.max_file_size,
+        service.no_require_git,
+        service.storage.clone(),
+    );
+    let mut view = view.lock().unwrap();
+    if method == "refresh"
+        && let Some(paths) = params.get("paths")
+    {
+        for path in paths.as_array().context("refresh paths must be an array")? {
+            let path = Path::new(path.as_str().context("invalid refresh path")?);
+            ensure!(
+                path.components()
+                    .all(|c| matches!(c, std::path::Component::Normal(_))),
+                "refresh paths must be worktree-relative"
+            );
+            let path = path
+                .to_str()
+                .unwrap()
+                .replace(std::path::MAIN_SEPARATOR, "/");
+            view.versions.retain(|known, _| {
+                known != &path
+                    && !known
+                        .strip_prefix(&path)
+                        .is_some_and(|suffix| suffix.starts_with('/'))
+            });
+        }
+    }
+    if method == "refresh"
+        || method == "reload"
+        || !view.ready
+        || view.dirty.load(Ordering::SeqCst)
+        || view.reconciled.elapsed() >= RECONCILE_INTERVAL
+    {
+        view.refresh(max_file_size, no_require_git, &storage)?;
+    }
+    match method {
+        "search" => view.search(params),
+        "files" => {
+            let scope = SearchScope::parse(params).map_err(anyhow::Error::msg)?;
+            let files = view
+                .filenames
+                .iter()
+                .filter(|p| {
+                    scope.relative(p).is_some()
+                        && view.visibility.is_visible(p, &scope.prefix, scope.hidden)
+                })
+                .collect::<Vec<_>>();
+            Ok(json!({"files":files,"hidden_complete":true}))
+        }
+        "status" | "refresh" | "reload" => Ok(
+            json!({"num_files":view.index.num_files(),"indexing":false,"hidden_complete":true,"watcher_active":true,"base_revision":view.base.revision,"overlay_files":view.index.live.num_files()}),
+        ),
+        _ => bail!("unknown shared method: {method}"),
+    }
+}
+
+pub fn run(
+    root: &Path,
+    index_path: Option<&Path>,
+    max_file_size: Option<u64>,
+    no_require_git: bool,
+    no_ignore: bool,
+) -> Result<()> {
+    ensure!(
+        !no_ignore,
+        "shared-serve requires worktree ignore admission; use --no-index for unrestricted scans"
+    );
+    let root = std::fs::canonicalize(root)?;
+    let storage = index_path.context("shared-serve requires --index-path")?;
+    let lock = super::try_acquire_server_lock(storage)?;
+    let service = Arc::new(Service::new(&root, storage, max_file_size, no_require_git)?);
+    let listener = TcpListener::bind("127.0.0.1:0")?;
+    super::ServerInfo {
+        pid: std::process::id(),
+        port: listener.local_addr()?.port(),
+    }
+    .save(storage)?;
+    let shutdown_storage = storage.to_path_buf();
+    super::ctrlc_handler(move || {
+        super::ServerInfo::cleanup(&shutdown_storage);
+        std::process::exit(0);
+    });
+    let _lock = lock;
+    for stream in listener.incoming() {
+        let stream = stream?;
+        let service = Arc::clone(&service);
+        std::thread::spawn(move || {
+            let result = (|| -> Result<()> {
+                let mut reader = BufReader::new(stream.try_clone()?);
+                let mut writer = stream;
+                let mut line = String::new();
+                while reader.read_line(&mut line)? > 0 {
+                    writeln!(writer, "{}", request(&line, &service))?;
+                    writer.flush()?;
+                    line.clear();
+                }
+                Ok(())
+            })();
+            if let Err(error) = result {
+                eprintln!("shared connection: {error:#}");
+            }
+        });
+    }
+    Ok(())
+}
