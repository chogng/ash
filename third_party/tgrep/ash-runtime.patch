+// Ash's limit is global and distinct from ripgrep's per-file max_count.
+// A bounded request uses ordered matching so later files never consume its row budget.
+pub(super) fn global_result_limit(params: &serde_json::Value) -> Result<Option<usize>, String> {
+    params.get("max_results").map(|value| {
+        value.as_u64().filter(|n| (1..=5001).contains(n)).map(|n| n as usize)
+            .ok_or_else(|| "max_results must be between 1 and 5001".into())
+    }).transpose()
+}
