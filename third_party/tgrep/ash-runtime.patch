index 0000000..f33e847
--- /dev/null
+++ b/tgrep-cli/src/ash.rs
@@ -0,0 +1,91 @@
+//! Ash packaging additions; indexing and worktree lifecycle remain upstream-owned.
+use anyhow::{Context, Result, ensure};
+use serde_json::json;
+use std::path::Path;
+use std::process::Command;
+
+pub fn identity(root: &Path) -> Result<()> {
+    let root = std::fs::canonicalize(root)?;
+    let plain = || println!("{}", json!({"directory":root,"revision":null}));
+    if !root.ancestors().any(|p| p.join(".git").exists()) {
+        plain();
+        return Ok(());
+    }
+    let git = |args: &[&str]| {
+        Command::new("git")
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .env_remove("GIT_INDEX_FILE")
+            .env("LC_ALL", "C")
+            .arg("-C")
+            .arg(&root)
+            .args(args)
+            .output()
+    };
+    let common = git(&["rev-parse", "--path-format=absolute", "--git-common-dir"])?;
+    if !common.status.success() {
+        ensure!(
+            String::from_utf8_lossy(&common.stderr).contains("not a git repository"),
+            "Git identity failed: {}",
+            String::from_utf8_lossy(&common.stderr)
+        );
+        plain();
+        return Ok(());
+    }
+    let directory = std::fs::canonicalize(std::str::from_utf8(&common.stdout)?.trim())?;
+    let revision = git(&["rev-parse", "--verify", "--quiet", "HEAD"])?;
+    if !revision.status.success() {
+        ensure!(
+            revision.status.code() == Some(1),
+            "Git revision failed: {}",
+            String::from_utf8_lossy(&revision.stderr)
+        );
+        plain();
+        return Ok(());
+    }
+    let top = git(&["rev-parse", "--show-toplevel"])?;
+    ensure!(top.status.success(), "Git worktree discovery failed");
+    if std::fs::canonicalize(std::str::from_utf8(&top.stdout)?.trim())? != root {
+        plain();
+        return Ok(());
+    }
+    println!(
+        "{}",
+        json!({"directory": directory,
+        "revision": std::str::from_utf8(&revision.stdout).context("non-UTF-8 Git revision")?.trim()})
+    );
+    Ok(())
+}
+
+static PARENT_WATCHED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static PARENT_ENDED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn watch_parent() {
+    PARENT_WATCHED.store(true, std::sync::atomic::Ordering::Release);
+    std::thread::spawn(|| {
+        use std::io::Read;
+        let mut byte = [0; 1];
+        loop {
+            match std::io::stdin().read(&mut byte) {
+                Ok(0) => {
+                    PARENT_ENDED.store(true, std::sync::atomic::Ordering::Release);
+                    return;
+                }
+                Ok(_) => {}
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => {}
+                Err(error) => {
+                    eprintln!("supervised host input failed without EOF: {error}");
+                    return;
+                }
+            }
+        }
+    });
+}
+
+pub fn parent_ended() -> bool {
+    PARENT_ENDED.load(std::sync::atomic::Ordering::Acquire)
+}
+
+pub fn parent_watched() -> bool {
+    PARENT_WATCHED.load(std::sync::atomic::Ordering::Acquire)
+}
diff --git a/tgrep-cli/src/ash_files.rs b/tgrep-cli/src/ash_files.rs
new file mode 100644
index 0000000..0e19022
--- /dev/null
+++ b/tgrep-cli/src/ash_files.rs
@@ -0,0 +1,502 @@
+//! Metadata-only file membership owned by each serving root.
+
+use crate::ash_request::Cancellation;
+use anyhow::Result;
+use anyhow::ensure;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeSet;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::sync::RwLock;
+use std::time::Duration;
+use std::time::Instant;
+use tgrep_core::gitignore::IgnoreMatcher;
+use tgrep_core::walker::MetaWalkOptions;
+use tgrep_core::worktrees::WorktreeError;
+
+const PAGE_LIMIT: usize = 1024;
+const HINT_LIMIT: usize = 1024;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Cursor {
+    epoch: u64,
+    offset: usize,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PageParams {
+    page_size: usize,
+    cursor: Option<Cursor>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FuzzyParams {
+    query: String,
+    max_results: usize,
+}
+#[derive(Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RefreshParams {
+    #[serde(default)]
+    pub changed: Vec<PathBuf>,
+    #[serde(default)]
+    pub full: bool,
+}
+
+struct Pending {
+    revision: u64,
+    full: bool,
+    paths: BTreeSet<String>,
+}
+struct Snapshot {
+    observed: u64,
+    epoch: u64,
+    paths: BTreeSet<String>,
+    ignore: Option<IgnoreMatcher>,
+    ignore_sources: BTreeSet<PathBuf>,
+    checked: Instant,
+    full_reconciliations: u64,
+    path_reconciliations: u64,
+    paths_checked: u64,
+}
+
+pub struct Catalog {
+    root: PathBuf,
+    options: MetaWalkOptions,
+    pending: Mutex<Pending>,
+    refresh: Mutex<()>,
+    snapshot: RwLock<Snapshot>,
+}
+
+impl Catalog {
+    pub fn new(root: &Path, mut options: MetaWalkOptions) -> Self {
+        // File membership includes binaries and large files without reading their bytes.
+        options.max_file_size = None;
+        for name in crate::ash_discovery::EXCLUDED_DIRECTORIES {
+            if !options.exclude_dirs.iter().any(|excluded| excluded == name) {
+                options.exclude_dirs.push((*name).to_owned());
+            }
+        }
+        Self {
+            root: root.to_path_buf(),
+            options,
+            pending: Mutex::new(Pending {
+                revision: 1,
+                full: true,
+                paths: BTreeSet::new(),
+            }),
+            refresh: Mutex::new(()),
+            snapshot: RwLock::new(Snapshot {
+                observed: 0,
+                epoch: 0,
+                paths: BTreeSet::new(),
+                ignore: None,
+                ignore_sources: BTreeSet::new(),
+                checked: Instant::now(),
+                full_reconciliations: 0,
+                path_reconciliations: 0,
+                paths_checked: 0,
+            }),
+        }
+    }
+
+    pub fn invalidate(&self) {
+        let mut pending = self.pending.lock().expect("filename changes");
+        pending.revision += 1;
+        pending.full = true;
+        pending.paths.clear();
+    }
+
+    pub fn invalidate_path(&self, path: &Path) {
+        let relative = path.strip_prefix(&self.root).unwrap_or(path);
+        let Some(text) = relative.to_str() else {
+            self.invalidate();
+            return;
+        };
+        let text = if cfg!(windows) {
+            text.replace('\\', "/")
+        } else {
+            text.to_owned()
+        };
+        if tgrep_core::rooted::validate_index_path(&text).is_err()
+            || relative.components().any(|part| {
+                matches!(
+                    part.as_os_str().to_str(),
+                    Some(".gitignore" | ".ignore" | "p4ignore.ini" | ".git")
+                )
+            })
+        {
+            self.invalidate();
+            return;
+        }
+        let mut pending = self.pending.lock().expect("filename changes");
+        pending.revision += 1;
+        if !pending.full {
+            pending.paths.insert(text);
+            if pending.paths.len() > HINT_LIMIT {
+                // A bounded hint set preserves correctness after bursts or missed notifications.
+                pending.full = true;
+                pending.paths.clear();
+            }
+        }
+    }
+
+    pub fn refresh(
+        &self,
+        changed: &[PathBuf],
+        full: bool,
+        cancellation: &Cancellation<'_>,
+    ) -> Result<u64> {
+        cancellation.check()?;
+        if full || changed.is_empty() {
+            self.invalidate();
+        } else {
+            for path in changed {
+                self.invalidate_path(path);
+            }
+        }
+        self.reconcile(cancellation)
+    }
+
+    pub fn status(&self) -> (bool, usize) {
+        let pending = self.pending.lock().expect("filename changes");
+        let snapshot = self.snapshot.read().expect("filename snapshot");
+        (snapshot.observed == pending.revision, snapshot.paths.len())
+    }
+
+    pub fn statistics(&self) -> Value {
+        let snapshot = self.snapshot.read().expect("filename snapshot");
+        json!({"full_reconciliations": snapshot.full_reconciliations,
+            "path_reconciliations": snapshot.path_reconciliations, "paths_checked": snapshot.paths_checked})
+    }
+
+    fn reconcile(&self, cancellation: &Cancellation<'_>) -> Result<u64> {
+        let _refresh = loop {
+            cancellation.check()?;
+            match self.refresh.try_lock() {
+                Ok(guard) => break guard,
+                Err(std::sync::TryLockError::Poisoned(error)) => {
+                    panic!("filename refresh: {error}")
+                }
+                Err(std::sync::TryLockError::WouldBlock) => {
+                    std::thread::sleep(Duration::from_millis(5))
+                }
+            }
+        };
+        let (revision, mut full, paths) = {
+            let pending = self.pending.lock().expect("filename changes");
+            let snapshot = self.snapshot.read().expect("filename snapshot");
+            if snapshot.observed == pending.revision {
+                return Ok(snapshot.epoch);
+            }
+            (pending.revision, pending.full, pending.paths.clone())
+        };
+        let mut updates = Vec::new();
+        if !full {
+            let snapshot = self.snapshot.read().expect("filename snapshot");
+            for relative in &paths {
+                cancellation.check()?;
+                let absolute = self.root.join(relative);
+                // Inspect ancestors too: directory-to-link replacement removes its old members.
+                let mut ancestor = absolute.parent();
+                let mut ordinary = true;
+                while let Some(path) = ancestor.filter(|path| *path != self.root) {
+                    match std::fs::symlink_metadata(path) {
+                        Ok(metadata) if metadata.file_type().is_dir() => {}
+                        Ok(_) => {
+                            ordinary = false;
+                            break;
+                        }
+                        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                            ordinary = false;
+                            break;
+                        }
+                        Err(error) => return Err(error.into()),
+                    }
+                    let prefix = format!(
+                        "{}/",
+                        path.strip_prefix(&self.root)
+                            .expect("contained ancestor")
+                            .to_string_lossy()
+                            .replace('\\', "/")
+                    );
+                    let known = snapshot
+                        .paths
+                        .range(prefix.clone()..)
+                        .next()
+                        .is_some_and(|candidate| candidate.starts_with(&prefix));
+                    if !known {
+                        let (gitignore, dot_ignore) = tgrep_core::gitignore::ignore_files_in(path);
+                        if gitignore
+                            .iter()
+                            .chain(dot_ignore.iter())
+                            .any(|source| !snapshot.ignore_sources.contains(source))
+                        {
+                            full = true;
+                            break;
+                        }
+                    }
+                    ancestor = path.parent();
+                }
+                if full {
+                    break;
+                }
+                let metadata = if ordinary {
+                    match std::fs::symlink_metadata(&absolute) {
+                        Ok(metadata) => Some(metadata),
+                        Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
+                        Err(error) => return Err(error.into()),
+                    }
+                } else {
+                    None
+                };
+                let mut replacement = Vec::new();
+                if metadata
+                    .as_ref()
+                    .is_some_and(|metadata| metadata.file_type().is_dir())
+                {
+                    let walk = tgrep_core::walker::walk_file_metadata_interruptible(
+                        &self.root,
+                        &self.options,
+                        Some(&absolute),
+                        &|| cancellation.check().is_err(),
+                    );
+                    cancellation.check()?;
+                    ensure!(
+                        walk.skipped_error == 0,
+                        "incomplete filename subtree discovery"
+                    );
+                    if walk
+                        .gitignore_files
+                        .iter()
+                        .chain(&walk.ignore_files)
+                        .any(|path| !snapshot.ignore_sources.contains(path))
+                    {
+                        full = true;
+                        break;
+                    }
+                    replacement = walk.listed_files;
+                } else if metadata
+                    .as_ref()
+                    .is_some_and(|metadata| metadata.file_type().is_file())
+                    && !snapshot
+                        .ignore
+                        .as_ref()
+                        .is_some_and(|ignore| ignore.is_ignored(Path::new(relative), false))
+                    && !self
+                        .options
+                        .exclude_paths
+                        .iter()
+                        .any(|path| absolute.starts_with(path))
+                    && !relative.rsplit_once('/').is_some_and(|(parent, _)| {
+                        parent.split('/').any(|part| {
+                            self.options
+                                .exclude_dirs
+                                .iter()
+                                .any(|excluded| excluded == part)
+                        })
+                    })
+                {
+                    replacement.push(relative.clone());
+                }
+                if snapshot
+                    .ignore_sources
+                    .iter()
+                    .any(|path| path.starts_with(&absolute))
+                {
+                    full = true;
+                    break;
+                }
+                updates.push((relative.clone(), replacement));
+            }
+        }
+        let walked = if full {
+            let walk = tgrep_core::walker::walk_file_metadata_interruptible(
+                &self.root,
+                &self.options,
+                None,
+                &|| cancellation.check().is_err(),
+            );
+            cancellation.check()?;
+            ensure!(walk.skipped_error == 0, "incomplete filename discovery");
+            let ignore = if self.options.no_ignore {
+                None
+            } else {
+                tgrep_core::gitignore::matcher_from_ignore_paths_with_options(
+                    &self.root,
+                    &walk.gitignore_files,
+                    &walk.ignore_files,
+                    self.options.no_require_git,
+                )
+            };
+            Some((walk, ignore))
+        } else {
+            None
+        };
+        cancellation.check()?;
+        // Publish only the captured revision. Notifications arriving during I/O remain pending.
+        let mut pending = self.pending.lock().expect("filename changes");
+        if revision != pending.revision {
+            return Err(WorktreeError::ChangedDuringReconcile.into());
+        }
+        let mut snapshot = self.snapshot.write().expect("filename snapshot");
+        let mut membership_changed = false;
+        if let Some((walk, ignore)) = walked {
+            let discovered: BTreeSet<_> = walk.listed_files.into_iter().collect();
+            membership_changed = snapshot.observed == 0 || snapshot.paths != discovered;
+            snapshot.paths = discovered;
+            snapshot.ignore = ignore;
+            snapshot.ignore_sources = walk
+                .gitignore_files
+                .into_iter()
+                .chain(walk.ignore_files)
+                .collect();
+            snapshot.full_reconciliations += 1;
+        } else {
+            for (path, replacement) in updates {
+                let prefix = format!("{path}/");
+                let old: Vec<_> = snapshot
+                    .paths
+                    .get(&path)
+                    .into_iter()
+                    .chain(
+                        snapshot
+                            .paths
+                            .range(prefix.clone()..)
+                            .take_while(|candidate| candidate.starts_with(&prefix)),
+                    )
+                    .cloned()
+                    .collect();
+                let replacement: BTreeSet<_> = replacement.into_iter().collect();
+                if old.iter().ne(replacement.iter()) {
+                    membership_changed = true;
+                    for path in old {
+                        snapshot.paths.remove(&path);
+                    }
+                    snapshot.paths.extend(replacement);
+                }
+            }
+            snapshot.path_reconciliations += 1;
+            snapshot.paths_checked += paths.len() as u64;
+        }
+        if membership_changed {
+            snapshot.epoch = revision;
+        }
+        snapshot.observed = revision;
+        // Point repairs must not postpone the safety walk indefinitely.
+        if full {
+            snapshot.checked = Instant::now();
+        }
+        pending.full = false;
+        pending.paths.clear();
+        Ok(snapshot.epoch)
+    }
+
+    fn current(&self, polling_interval: Duration, cancellation: &Cancellation<'_>) -> Result<()> {
+        let due = self
+            .snapshot
+            .read()
+            .expect("filename snapshot")
+            .checked
+            .elapsed()
+            >= polling_interval;
+        if due {
+            self.invalidate();
+        }
+        self.reconcile(cancellation)?;
+        Ok(())
+    }
+
+    pub fn page(
+        &self,
+        params: &Value,
+        polling_interval: Duration,
+        cancellation: &Cancellation<'_>,
+    ) -> Result<Value> {
+        let params: PageParams = serde_json::from_value(params.clone())?;
+        ensure!(
+            (1..=PAGE_LIMIT).contains(&params.page_size),
+            "file page_size must be 1..=1024"
+        );
+        cancellation.check()?;
+        self.current(polling_interval, cancellation)?;
+        let pending = self.pending.lock().expect("filename changes");
+        let snapshot = self.snapshot.read().expect("filename snapshot");
+        ensure!(
+            snapshot.observed == pending.revision,
+            WorktreeError::ChangedDuringReconcile
+        );
+        let offset = match params.cursor {
+            Some(cursor) => {
+                ensure!(cursor.epoch == snapshot.epoch, WorktreeError::NotReady);
+                cursor.offset
+            }
+            None => 0,
+        };
+        ensure!(
+            offset <= snapshot.paths.len(),
+            "file cursor offset exceeds its snapshot"
+        );
+        let files: Vec<_> = snapshot
+            .paths
+            .iter()
+            .skip(offset)
+            .take(params.page_size)
+            .collect();
+        let end = offset + files.len();
+        let cursor =
+            (end < snapshot.paths.len()).then(|| json!({"epoch":snapshot.epoch,"offset":end}));
+        Ok(
+            json!({"files":files,"cursor":cursor,"epoch":snapshot.epoch,"total_files":snapshot.paths.len(),"files_ready":true}),
+        )
+    }
+
+    pub fn fuzzy(
+        &self,
+        params: &Value,
+        polling_interval: Duration,
+        cancellation: &Cancellation<'_>,
+    ) -> Result<Value> {
+        let params: FuzzyParams = serde_json::from_value(params.clone())?;
+        ensure!(
+            params.query.len() <= 1024
+                && !params.query.contains('\0')
+                && (1..=5000).contains(&params.max_results),
+            "invalid fuzzy file query or limit"
+        );
+        cancellation.check()?;
+        self.current(polling_interval, cancellation)?;
+        let snapshot = self.snapshot.read().expect("filename snapshot");
+        let deadline = Instant::now() + Duration::from_secs(30);
+        let mut checked = 0usize;
+        let ranked = crate::ash_ranking::rank(
+            snapshot.paths.iter().map(Ok),
+            &params.query,
+            params.max_results,
+            || {
+                if checked % 128 == 0 {
+                    cancellation.check()?;
+                }
+                checked += 1;
+                ensure!(Instant::now() < deadline, "file search exceeded 30 seconds");
+                Ok::<(), anyhow::Error>(())
+            },
+        )?;
+        cancellation.check()?;
+        // Invalidations can proceed while scoring. Never acknowledge a stale result.
+        let observed = snapshot.observed;
+        let result = json!({"matches":ranked.matches.iter().map(|matched| json!({"score":matched.score,"path":matched.path,"indices":matched.indices})).collect::<Vec<_>>(),
+            "total_match_count":ranked.total_match_count,"scanned_file_count":ranked.scanned_file_count,
+            "epoch":snapshot.epoch,"files_ready":true});
+        drop(snapshot);
+        ensure!(
+            self.pending.lock().expect("filename changes").revision == observed,
+            WorktreeError::ChangedDuringReconcile
+        );
+        Ok(result)
+    }
+}
diff --git a/tgrep-cli/src/ash_request.rs b/tgrep-cli/src/ash_request.rs
new file mode 100644
index 0000000..c18df6a
--- /dev/null
+++ b/tgrep-cli/src/ash_request.rs
@@ -0,0 +1,77 @@
+//! Request-scoped cancellation for opt-in, reversible filename operations.
+
+use anyhow::Result;
+use std::io::ErrorKind;
+use std::net::TcpStream;
+
+#[derive(Debug)]
+pub struct Cancelled;
+
+impl std::fmt::Display for Cancelled {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("file request cancelled")
+    }
+}
+
+impl std::error::Error for Cancelled {}
+
+pub enum Cancellation<'a> {
+    Disabled,
+    Peer(&'a TcpStream),
+}
+
+impl Cancellation<'_> {
+    pub fn check(&self) -> Result<()> {
+        let Self::Peer(stream) = self else {
+            return Ok(());
+        };
+        match stream.peek(&mut [0]) {
+            Ok(0) => Err(Cancelled.into()),
+            Ok(_) => Ok(()),
+            Err(error)
+                if matches!(error.kind(), ErrorKind::WouldBlock | ErrorKind::Interrupted) =>
+            {
+                Ok(())
+            }
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    ErrorKind::ConnectionReset
+                        | ErrorKind::NotConnected
+                        | ErrorKind::BrokenPipe
+                        | ErrorKind::ConnectionAborted
+                ) =>
+            {
+                Err(Cancelled.into())
+            }
+            Err(error) => Err(error.into()),
+        }
+    }
+}
+
+pub fn enabled(method: &str, opt_in: bool) -> bool {
+    opt_in && matches!(method, "files/fuzzy" | "files/refresh" | "files/page")
+}
+
+pub fn run<T>(
+    stream: &TcpStream,
+    enabled: bool,
+    action: impl FnOnce(&Cancellation<'_>) -> Result<T>,
+) -> Result<T> {
+    if !enabled {
+        return action(&Cancellation::Disabled);
+    }
+    // Opt-in clients keep their sending half open until the request completes. Legacy clients
+    // may half-close it while waiting for a reply, so only opt-in requests observe EOF as cancel.
+    stream.set_nonblocking(true)?;
+    struct Restore<'a>(&'a TcpStream);
+    impl Drop for Restore<'_> {
+        fn drop(&mut self) {
+            let _ = self.0.set_nonblocking(false);
+        }
+    }
+    let _restore = Restore(stream);
+    let cancellation = Cancellation::Peer(stream);
+    cancellation.check()?;
+    action(&cancellation)
+}
