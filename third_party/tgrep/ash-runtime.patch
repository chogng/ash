+/// Export credentials only through the packaged helper, using the upstream private-file checks.
+pub(crate) fn ash_identity(root: &std::path::Path) -> anyhow::Result<()> {
+    use std::io::Read;
+    let repository = tgrep_core::generations::Repository::discover(root)?;
+    let file = std::fs::File::open(repository.common_dir().join(protocol_v2::MARKER))?;
+    let registration: protocol_v2::Registration = serde_json::from_reader(file.take(4096))?;
+    let auth = protocol_v2::Authentication::read(&repository, &registration)?;
+    println!(
+        "{}",
+        serde_json::json!({"registration":registration,"authorization":auth.token})
+    );
+    Ok(())
+}
