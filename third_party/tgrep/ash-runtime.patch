+//! Ash packaging additions; indexing and worktree lifecycle remain upstream-owned.
+use anyhow::{Context, Result, ensure};
+use serde_json::json;
+use std::path::Path;
+use std::process::Command;
+
+pub fn identity(root: &Path) -> Result<()> {
+    let root = std::fs::canonicalize(root)?;
+    let plain = || println!("{}", json!({"directory":root,"revision":null}));
+    if !root.ancestors().any(|p| p.join(".git").exists()) {
+        plain();
+        return Ok(());
+    }
+    let git = |args: &[&str]| {
+        Command::new("git")
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .env_remove("GIT_INDEX_FILE")
+            .env("LC_ALL", "C")
+            .arg("-C")
+            .arg(&root)
+            .args(args)
+            .output()
+    };
+    let common = git(&["rev-parse", "--path-format=absolute", "--git-common-dir"])?;
+    if !common.status.success() {
+        ensure!(
+            String::from_utf8_lossy(&common.stderr).contains("not a git repository"),
+            "Git identity failed: {}",
+            String::from_utf8_lossy(&common.stderr)
+        );
+        plain();
+        return Ok(());
+    }
+    let directory = std::fs::canonicalize(std::str::from_utf8(&common.stdout)?.trim())?;
+    let revision = git(&["rev-parse", "--verify", "--quiet", "HEAD"])?;
+    if !revision.status.success() {
+        ensure!(
+            revision.status.code() == Some(1),
+            "Git revision failed: {}",
+            String::from_utf8_lossy(&revision.stderr)
+        );
+        plain();
+        return Ok(());
+    }
+    let top = git(&["rev-parse", "--show-toplevel"])?;
+    ensure!(top.status.success(), "Git worktree discovery failed");
+    if std::fs::canonicalize(std::str::from_utf8(&top.stdout)?.trim())? != root {
+        plain();
+        return Ok(());
+    }
+    println!(
+        "{}",
+        json!({"directory": directory,
+        "revision": std::str::from_utf8(&revision.stdout).context("non-UTF-8 Git revision")?.trim()})
+    );
+    Ok(())
+}
