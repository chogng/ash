package(default_visibility = ["//visibility:public"])

exports_files(["v8_bazel_build_dir.patch", "rules_cc_windows_build_tools.patch"])

# On a native Windows/MSVC host, let Bazel run tests whose target ABI is
# Windows gnullvm. This is the same host/target bridge used by Codex.
toolchain(
    name = "windows_gnullvm_tests_on_msvc_host",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)
