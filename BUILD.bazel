load("@apple_support//xcode:xcode_config.bzl", "xcode_config")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

# Source compilation is explicit; editing Ash does not rebuild V8 by default.
bool_flag(
    name = "rusty_v8_from_source",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Only the V8 archive transition enables Chromium's C++ header/runtime policy.
# Rust build tools outside that closure retain the ordinary LLVM toolchain.
bool_flag(
    name = "rusty_v8_custom_libcxx",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# First-party Rust rules need the same version embedded by Cargo, including TUI snapshots.
genrule(
    name = "workspace-version-env",
    srcs = ["Cargo.toml"],
    outs = ["workspace-version.env"],
    cmd = """awk '/^\\[workspace.package\\]$$/ { in_package = 1; next } in_package && /^\\[/ { exit } in_package && /^version = / { gsub(/"/, "", $$3); print "CARGO_PKG_VERSION=" $$3; exit }' $(location Cargo.toml) > $@ && test -s $@""",
    visibility = ["//visibility:public"],
)

xcode_config(name = "disable_xcode")

# Keep host selection explicit so the Rust toolchain sees the same libc/ABI
# constraints on every local and CI machine.
platform(
    name = "local_linux",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "local_windows",
    constraint_values = [
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "local_windows_msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "windows_x86_64_gnullvm",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "windows_aarch64_gnullvm",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "windows_x86_64_msvc",
    # Bazel applies these only in the MSVC host's configuration. Ordinary GNU
    # callers retain their own target and execution toolchains.
    flags = [
        "--host_platform=//:local_windows_msvc",
        "--extra_toolchains=@local_config_cc//:all",
        "--@rules_rust//rust/settings:toolchain_linker_preference=rust",
    ],
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

platform(
    name = "windows_aarch64_msvc",
    # Bazel applies these only in the MSVC host's configuration. Ordinary GNU
    # callers retain their own target and execution toolchains.
    flags = [
        "--host_platform=//:local_windows_msvc",
        "--extra_toolchains=@local_config_cc//:all",
        "--@rules_rust//rust/settings:toolchain_linker_preference=rust",
    ],
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

alias(
    name = "ash",
    actual = "//cli:ash",
    visibility = ["//visibility:public"],
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

filegroup(
    name = "v8_host_binaries",
    srcs = [
        "//crates/code-mode-host:ash-code-mode-host",
        "//crates/external-js-ext:ash-external-js-ext",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runtime_package_inputs",
    srcs = glob(["resources/product-services/**"]) + [
        "third_party/vscode/LICENSE.txt",
    ],
    visibility = ["//visibility:public"],
)
