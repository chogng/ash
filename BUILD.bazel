load("@apple_support//xcode:xcode_config.bzl", "xcode_config")

xcode_config(name = "disable_xcode")

# Keep host selection explicit so the Rust toolchain sees the same libc/ABI
# constraints on every local and CI machine.
platform(
    name = "local_linux",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "local_windows",
    constraint_values = [
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "local_windows_msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "windows_x86_64_gnullvm",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "windows_aarch64_gnullvm",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "windows_x86_64_msvc",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

platform(
    name = "windows_aarch64_msvc",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

alias(
    name = "ash",
    actual = "//ash-code/cli:ash",
    visibility = ["//visibility:public"],
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "build/__init__.py",
])
